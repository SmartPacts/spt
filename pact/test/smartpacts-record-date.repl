(begin-tx "N-11 only admin may cancel")
(env-keys [])
(expect-failure "a stranger cannot cancel a record date"
  "Keyset failure"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-snapshot))
