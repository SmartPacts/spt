  "SPT there is no scheduled record date to cancel"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-snapshot))
(rollback-tx)

(begin-tx "N-10 cancelling inside the lead is refused")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (time "2026-06-10T00:00:00Z"))
(commit-tx)
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-09T23:00:00Z") })
(begin-tx "N-10a too close to landing")
(env-keys ["admin-key"])
(expect-failure "a record date inside MIN-RETRACT-LEAD can no longer be cancelled"
  "SPT record date is too close to landing to be cancelled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-snapshot))
