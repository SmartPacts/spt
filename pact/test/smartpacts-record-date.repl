  (time "2026-06-10T00:00:00Z"))
(expect "cancelled" "record date cancelled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-snapshot))
(expect "and nothing sealed" 3
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-gen))
(commit-tx)

(begin-tx "N-9 cancelling when nothing is scheduled")
(env-keys ["admin-key"])
