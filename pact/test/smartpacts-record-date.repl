;; ===========================================================================
;; smartpacts-record-date — THE RECORD DATE (the design record / a later change).
;;
;; the design record changes the ORDER, not the accrual: seal the float FIRST, choose the rate
;; SECOND, against a denominator that can no longer move. This suite proves the
;; mechanism and, deliberately, proves the two places where I had to CORRECT the ADR
;; while implementing it. Both corrections are pinned by a NAMED test that goes RED
;; when the fix is removed — the ADR's own residual-risk section demands exactly that
;; for `snap-corr`, whose derivation is the load-bearing part.
;;
;; 🔴 THE SPIKES THAT PRODUCED the design record's EVIDENCE ARE GONE (they lived in /tmp, and
;; the project notes forbids copying a scratch module into this repo). The ADR says the
;; scenarios must be "rebuilt properly as named tests" — this file is that rebuild.
;; A number quoted from the ADR is NOT evidence here; every assertion below is
;; computed from the contract in this run.
;;
;; WHAT THE PRE-the design record MODULE DID WRONG, reproduced as arithmetic rather than
;; asserted: `declare-round` checked `pool >= floor12(declared-liability + rate *
;; get-circulating)` AT DECLARATION, and `get-circulating` kept growing until
;; `effective-at` — `buy`, the permissionless `release-tranche`, and inbound
;; cross-chain legs all raise it. So the bar was a FLOOR on a number that moved.
;; DF-4 below measures the shortfall on THIS module with the fix in place and shows
;; it is zero.
;; ===========================================================================
(load "setup.repl")

(begin-tx "activate launch + seed alice 3000 / bob 2000  (circulating 5000)")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.init 0.5)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.resume-sale)
(env-data { "alice": { "keys": ["alice-key"], "pred": "keys-all" }
       , "bob":   { "keys": ["bob-key"],   "pred": "keys-all" }
       , "carol": { "keys": ["carol-key"], "pred": "keys-all" }
 ;; 🔴 FRANK EXISTS FOR ONE REASON: he buys while snap-gen is STILL 0, and never
 ;; writes again until he claims. Any holder who acquires AFTER a generation has
 ;; sealed is checkpointed by that very credit, so `snap-index = 0` with a
 ;; non-zero balance is unreachable for them — which is why deleting
 ;; `snap-corr-of`'s idx = 0 branch was invisible to every other account here.
       , "frank": { "keys": ["frank-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "alice" 4000.0) (coin.TRANSFER "sender00" "bob" 4000.0) (coin.TRANSFER "sender00" "carol" 4000.0)] }])
(coin.transfer-create "sender00" "alice" (read-keyset 'alice) 4000.0)
(coin.transfer-create "sender00" "bob"   (read-keyset 'bob)   4000.0)
(coin.transfer-create "sender00" "carol" (read-keyset 'carol) 4000.0)
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "frank" 4000.0)] }])
(coin.transfer-create "sender00" "frank" (read-keyset 'frank) 4000.0)
(env-sigs [{ "key": "alice-key", "caps": [(coin.TRANSFER "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "alice" (read-keyset 'alice) 3000.0)
(env-sigs [{ "key": "bob-key", "caps": [(coin.TRANSFER "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "bob" (read-keyset 'bob) 2000.0)
(env-sigs [{ "key": "frank-key", "caps": [(coin.TRANSFER "frank" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "frank" (read-keyset 'frank) 1000.0)
(expect "circulating 6000" 6000.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(expect "no generation has sealed yet" 0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-gen))
(commit-tx)

;; ===========================================================================
;; N-1 — A ROUND CANNOT BE DECLARED WITHOUT A SEALED RECORD DATE.
;; ONE MODE, ONE CODE PATH, NO HYBRID: there is deliberately no fallback, because a
;; fallback is how the pre-the design record shortfall would come back through the door marked
;; convenience — and after the freeze it could never be removed.
;; ===========================================================================
(begin-tx "N-1 no sealed record date")
(env-keys ["admin-key"])
(expect-failure "a round with no sealed record date is refused"
  "SPT no record date has sealed on this chain; schedule one before declaring"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R-NOGEN" 0.02 (time "2026-06-05T00:00:00Z")))
(rollback-tx)

;; ===========================================================================
;; N-2 / N-3 — the record date's own bounds. Same two bounds a round gets, for the
;; same reasons: a record date with no cancel runway is a decision with no remedy,
;; and an unbounded one is the mistyped year that killed the award subsystem.
;; ===========================================================================
(begin-tx "N-2 record date with no cancel runway")
(env-keys ["admin-key"])
(expect-failure "a record date inside two retraction leads is refused"
  "SPT record date must leave at least two retraction leads of runway"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
    (time "2026-06-01T06:00:00Z")))
(rollback-tx)

;; 🔴 N-3 IS DELETED (the design record, a later change). It asserted a mistyped year-2099 record date was
;; refused outright by MAX-ROUND-LEAD. That constant is gone from BOTH its consumers, and the
;; boundary is recorded at `schedule-snapshot`: the design record predates the design record, so it never covered
;; this path, and the deletion was extended here because the design record's own test — is the typo
;; recoverable by the operator alone? — is satisfied MORE strongly here than on the round
;; path. `cancel-snapshot` accepts any date more than MIN-RETRACT-LEAD away, so a 2099 record
;; date stays cancellable for seventy-three years. N-9/N-10/N-11 below still pin that remedy,
;; which is why deleting this one does not leave the far-future case unexamined.

(begin-tx "N-4 only admin may name a record date")
(env-keys [])
(expect-failure "a stranger cannot schedule a record date"
  "Keyset failure"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
    (time "2026-06-02T00:00:00Z")))
(rollback-tx)

;; ===========================================================================
;; G-1 — SCHEDULE, then SEAL. The instant is announced with NO RATE ATTACHED; that is
;; the whole of the founder's step 1.
;; ===========================================================================
(begin-tx "G-1a schedule the record date")
(env-keys ["admin-key"])
(expect "record date scheduled" "record date scheduled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
    (time "2026-06-02T00:00:00Z")))
(expect "still no generation — scheduling is not sealing" 0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-gen))
(commit-tx)

(begin-tx "N-5 a second record date cannot be scheduled")
(env-keys ["admin-key"])
(expect-failure "one record date at a time"
  "a record date is already scheduled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
    (time "2026-06-03T00:00:00Z")))
(rollback-tx)

(begin-tx "N-6 a round cannot be declared while a record date is unsealed")
(env-keys ["admin-key"])
(expect-failure "declaring against an unsealed record date is refused"
  "SPT cannot declare a round while a record date is scheduled and unsealed"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R-EARLY" 0.02 (time "2026-06-05T00:00:00Z")))
(rollback-tx)

;; --- IT SEALS LAZILY. The instant passes with NO ACTIVITY; the seal still records the
;; --- correct float, because the float only changes at a write.
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-02T00:00:01Z") })
(begin-tx "G-1b seal — permissionless, by a stranger with no keys at all")
(env-keys [])
(expect "advance-snapshot seals" "sealed"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot))
(expect "generation 1 is open" 1
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-gen))
(expect "the sealed float is the float at the instant" 6000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snapshot-circulating))
(expect "the schedule is cleared by the seal" true
  (= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-at)
     n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.EPOCH))
(expect "no rate is attached yet" 0.0
  (at 'rate (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 1)))
(expect "advance-snapshot is idempotent — a second call does nothing" "no-seal"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot))
(commit-tx)

;; ===========================================================================
;; 🔴 DF-1 — THE PROPERTY THE WHOLE ADR EXISTS FOR:
;; TOTAL PAID == rate x SEALED FLOAT, with heavy churn inside the window.
;;
;; The float MOVES between the record instant and the round taking effect — exactly
;; the movement that produced the measured 150 % shortfall on the pre-the design record module.
;; Here carol buys 3,000 NEW tokens inside the window (circulating 5000 -> 8000) and
;; alice ships 1,000 to bob. Under the design record's bar the chain would owe rate*8000 while
;; being funded for rate*5000. Under the design record the debt is rate*5000, immovably.
;; ===========================================================================
(begin-tx "DF-1a churn INSIDE the window: carol buys 3000 new, alice sends bob 1000")
(env-sigs [{ "key": "carol-key", "caps": [(coin.TRANSFER "carol" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "carol" (read-keyset 'carol) 3000.0)
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "bob" 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "alice" "bob" 1000.0)
(expect "circulating GREW to 9000 inside the window" 9000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(expect "but the SEALED float did not move" 6000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snapshot-circulating))
(commit-tx)

;; --- fund against the SEALED float, using the module's own helper. `funding-needed`
;; --- and `declare-round` MUST agree — see A-1 for the pin that they do.
(begin-tx "DF-1b fund the exact bar")
(env-keys ["admin-key"])
(let ((need (at 'shortfall (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed 0.02))))
  (expect "the bar is rate x SEALED float (6000), not rate x current float (9000)" 120.0 need)
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

(begin-tx "DF-1c declare R1 against the sealed generation")
(env-keys ["admin-key"])
(expect "round declared" "round declared"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R1" 0.02 (time "2026-06-03T00:00:00Z")))
(expect "the rate is bound to generation 1" 0.02
  (at 'rate (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 1)))
(commit-tx)

;; ===========================================================================
;; N-7 — a later change CLOSES HERE. A duplicate declaration used to be accepted and silently
;; DOUBLED the chain's rate — the operator re-running a leg they thought had failed.
;; ===========================================================================
(begin-tx "N-7 duplicate declaration on the same record date")
(env-keys ["admin-key"])
(expect-failure "a second round on the same record date is REFUSED, not doubled"
  "SPT this record date already carries a declared round"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R1-DUP" 0.02 (time "2026-06-03T00:00:00Z")))
(rollback-tx)

(begin-tx "N-8 a record date cannot be scheduled while a round is pending-effective")
(env-keys ["admin-key"])
(expect-failure "no overlapping generations"
  "SPT cannot schedule a record date while a declared round is not yet effective"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
    (time "2026-06-04T00:00:00Z")))
(rollback-tx)

;; --- the round takes effect ---
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:01Z") })

(begin-tx "DF-1d EVERY holder claims; the total is measured, not assumed")
(let* ((pool0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
       (a (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "alice"))
       (b (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "bob"))
 ;; 🔴 FRANK'S snap-index IS STILL 0 — he has not written since before the seal.
 ;; Without the idx = 0 branch his correction reads (0.0 - balance) * (rpt - rd) =
 ;; his ENTIRE accrual, negated, and this claim aborts "nothing to claim".
       (f (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "frank"))
       (paid (+ (+ a b) f)))
 ;; carol bought INSIDE the window, so she held nothing at the record instant and is
 ;; owed nothing — the ADR's "float arriving after the instant is free", measured.
  (expect-failure "carol bought inside the window and is owed nothing"
    "nothing to claim"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "carol"))
  (expect "alice is paid on her RECORD-INSTANT balance (3000), not her current 2000" 60.0 a)
  (expect "bob is paid on his RECORD-INSTANT balance (2000), not his current 3000" 40.0 b)
 ;; 🔴 THE HEADLINE. Not "close enough" — exact.
  (expect "🔴 a never-checkpointed holder is paid in full" 20.0 f)
  (expect "TOTAL PAID == rate x SEALED FLOAT, exactly" (* 0.02 6000.0) paid)
  (expect "the pool funded exactly the debt: nothing left over, nothing short" 0.0
    (- pool0 paid)))
(commit-tx)

;; ===========================================================================
;; 🔴 DF-2 — THE O(1) LIABILITY MATCHES A NAIVE PER-HOLDER SUM.
;; `snap-corr` is a STORED AGGREGATE and its derivation is the load-bearing part of
;; the design record (the ADR's own residual-risk section says so). A test that merely exercises
;; it proves nothing, so this compares the O(1) identity against a sum computed the
;; slow way, at several points including mid-churn and mid-claim.
;; ===========================================================================
(begin-tx "DF-2 setup: a second generation with churn, unclaimed")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (time "2026-06-04T00:00:00Z"))
(commit-tx)
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-04T00:00:01Z") })
(begin-tx "DF-2a seal generation 2")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(expect "generation 2, sealed float 9000" 9000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snapshot-circulating))
(commit-tx)

(begin-tx "DF-2b fund + declare R2, then churn inside the window")
(env-keys ["admin-key"])
(let ((need (at 'shortfall (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed 0.01))))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)
(begin-tx "DF-2c declare R2")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
  "R2" 0.01 (time "2026-06-05T00:00:00Z"))
(commit-tx)

;; naive per-holder sum, computed the slow way from the public read.
(begin-tx "DF-2d O(1) == naive sum, INSIDE the window (correction still zero)")
(let ((naive (fold (+) 0.0
                (map (lambda (a:string)
                       (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                     ["alice" "bob" "carol" "frank"]))))
  (expect "O(1) liability == naive per-holder sum" naive
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))
(commit-tx)

(begin-tx "DF-2e churn inside the R2 window, then re-check the identity")
(env-sigs [{ "key": "bob-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "bob" "carol" 2500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "bob" "carol" 2500.0)
(let ((naive (fold (+) 0.0
                (map (lambda (a:string)
                       (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                     ["alice" "bob" "carol" "frank"]))))
  (expect "O(1) == naive, MID-CHURN inside an open window" naive
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))
;; ===========================================================================
;; 🔴 DF-2e2 — KILLS MUTATION 8: `snap-m` losing its `min(rpt, base+rate)` cap.
;;
;; R2 IS DECLARED BUT NOT YET EFFECTIVE, and bob has just written, so he carries a real
;; `snap-balance` differing from his balance. THAT is the only state the cap governs: it
;; is what keeps a generation's correction confined to a round that has actually landed.
;; Without it bob's correction reads (snap-balance - balance) * rate = 2500 * 0.01 = 25.0
;; KDA of accrual from a round NOBODY HAS BEEN PAID FOR YET, and carol's reads -25.0.
;;
;; 🔴 AND THIS HAD TO BE AN ABSOLUTE ASSERTION, NOT O(1)-vs-naive. Every identity check in
;; this suite compares `award-liability` against a sum of `pending-awards-of`, and BOTH
;; sides route through `snap-corr-of` -> `snap-m`. A bug in the cap moves both by the same
;; amount, so the comparison agrees while both are wrong — a check that cannot fail on the
;; thing it appears to be checking. Measured: mutation 8 was SILENT against six identity
;; assertions and dies against this one line.
(expect "🔴 a DECLARED-but-not-yet-effective round owes bob NOTHING" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob"))
(expect "🔴 ...and owes carol nothing either — not a NEGATIVE amount" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "carol"))
(expect "the whole chain owes nothing until R2 lands" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
(commit-tx)

(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-05T00:00:01Z") })
(begin-tx "DF-2f R2 effective: identity holds ACROSS the m-jump, before any write")
(let ((naive (fold (+) 0.0
                (map (lambda (a:string)
                       (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                     ["alice" "bob" "carol" "frank"]))))
 ;; 🔴 THIS IS THE `snap-open` CASE. The round just became effective, `m` jumped for
 ;; every account checkpointed in generation 2 AT ONCE, and NO transaction has run to
 ;; fold that into snap-corr. If snap-open were wrong — or absent — this is where the
 ;; O(1) reader and the truth diverge, and `fund-awards` would accept an underfunded pool.
  (expect "O(1) == naive at the m-jump, with snap-corr NOT yet folded" naive
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))
(commit-tx)

(begin-tx "DF-2g settle happens, then the identity STILL holds")
(env-keys [])
(expect "the first toucher settles generation 2" "settled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot))
(let ((naive (fold (+) 0.0
                (map (lambda (a:string)
                       (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                     ["alice" "bob" "carol" "frank"]))))
  (expect "O(1) == naive AFTER the fold — snap-corr now carries what snap-open did" naive
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))
(commit-tx)

(begin-tx "DF-2h MID-CLAIM: one holder claims, identity holds for the rest")
(let ((a (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "bob")))
  (let ((naive (fold (+) 0.0
                  (map (lambda (acct:string)
                         (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of acct))
                       ["alice" "bob" "carol" "frank"]))))
    (expect "O(1) == naive MID-CLAIM" naive
      (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))))
(commit-tx)

(begin-tx "DF-2i R2's total is ALSO rate x its own sealed float")
(let* ((a (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "alice"))
       (c (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "carol"))
       (f (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "frank")))
 ;; bob already claimed in DF-2h; his payout plus these two is R2's whole cost.
  (expect "everything owed is now paid: the O(1) liability is zero" 0.0
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
  (expect "and the pool is empty to the last decimal — funded EXACTLY, never over" 0.0
    (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))
(commit-tx)

;; ===========================================================================
;; A-1 — `funding-needed` AND `declare-round` USE ONE IMPLEMENTATION.
;; the handoff rule 2, paid for once already: a generator and a checker each owning a
;; copy of the same rule cost this project a full round of work. This pins that the
;; number the operator funds IS the number the gate enforces — to the last decimal, at
;; a rate chosen to produce sub-1e-12 dust in the liability.
;; ===========================================================================
(begin-tx "A-1 the funding tool and the gate agree exactly")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (time "2026-06-06T00:00:00Z"))
(commit-tx)
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-06T00:00:01Z") })
(begin-tx "A-1a seal generation 3 and compare the two numbers")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(let ((r 0.000000000007))
  (expect "funding-needed.required IS round-funding-bar, not a re-derivation"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.round-funding-bar r)
    (at 'required (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed r))))
(commit-tx)

;; ===========================================================================
;; A-2 — funding ONE TRILLIONTH short is refused. The founder's step 6: the module
;; refuses the declaration on any chain a single 1e-12 short.
;; ===========================================================================
(begin-tx "A-2 provision the bar, minus 1e-12")
(env-keys ["admin-key"])
(let ((need (- (at 'shortfall (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed 0.01))
               0.000000000001)))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)
(begin-tx "A-2a and the declaration is refused")
(env-keys ["admin-key"])
(expect-failure "one trillionth short is still short"
  "SPT award pool does not cover the liability this round declares"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R3" 0.01 (time "2026-06-07T00:00:00Z")))
(rollback-tx)

;; ===========================================================================
;; R-1 — RETRACTION REWINDS BOTH SIDES. 🔴 BOTH OR NEITHER: zeroing only the
;; award-rounds row leaves `snap-m`'s cap at base+rate, so every account checkpointed
;; in that generation keeps a live correction against a round that no longer pays —
;; the accrual still pays, on money nobody funded.
;; ===========================================================================
(begin-tx "R-1 top up, declare R3, then retract it")
(env-keys ["admin-key"])
(let ((need (at 'shortfall (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed 0.01))))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)
(begin-tx "R-1a declare then retract")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
  "R3" 0.01 (time "2026-06-08T00:00:00Z"))
(expect "the generation carries the rate" 0.01
  (at 'rate (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 3)))
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.retract-round "R3")
(expect "🔴 the GENERATION's rate is rewound too, not just the round" 0.0
  (at 'rate (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 3)))
(expect "and the liability it promised is gone" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
(commit-tx)

(begin-tx "R-1b a retracted generation is RE-DECLARABLE on the SAME record date")
(env-keys ["admin-key"])
(expect "a rate typo is corrected without re-running the ceremony" "round declared"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R3-FIXED" 0.01 (time "2026-06-08T00:00:00Z")))
(commit-tx)

;; ===========================================================================
;; a finding — A WRONGLY-DATED RECORD DATE IS CANCELLABLE, and cancellation has the same
;; lead-time bound as retraction, for the same reason (a partial cancellation across
;; 20 chains locks the divergence in rather than failing safe — verify after cancelling).
;; ===========================================================================
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-08T00:00:01Z") })
(begin-tx "a finding schedule then cancel")
(env-keys ["admin-key"])
