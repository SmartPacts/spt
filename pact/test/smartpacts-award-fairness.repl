(begin-tx "DF-9b: future round declared LAST is fine; apply-round folds only the effective prefix")
(env-keys ["admin-key"])
;; declare a FUTURE round (>= latest effective-at, so allowed): it must NOT accrue yet,
;; and apply-round must fold only the already-effective prefix, leaving the future one alone.
;; rpt here = R1 .02 + R2 .02 + R3 .01 + R4 .03 + R5 .10 + R6 .05 = 0.23 (pinned as a literal
;; so the DF-9c "+0.07 exactly once" delta is a real assertion, not a same-time tautology).
(let ((rpt-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)))
  (expect "pre-FUT rpt is exactly 0.23 (six effective rounds)" 0.23 rpt-before)
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "FUT" 0.07 (time "2027-01-01T00:00:00Z"))
  (expect "future round does NOT change rpt yet (effective-at > now)" rpt-before
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
 ;; apply-round materializes the effective prefix; rpt is unchanged in VALUE (materialization
 ;; is transparent) and the future round is still excluded.
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.apply-round "prefix")
  (expect "get-rpt unchanged after apply-round (future round still excluded)" rpt-before
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
 ;; DOUBLE-COUNT REGRESSION: a SECOND apply-round must be a no-op (all effective rounds
 ;; already folded AND advanced past — the fold and the advance covered the same set).
  (expect-failure "second apply-round is a no-op (no rate re-counted)"
  "no newly-effective rounds to apply"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.apply-round "again"))
  (expect "get-rpt STILL unchanged after the repeat (no permanent inflation)" rpt-before
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)))
(commit-tx)

;; ===========================================================================
;; DF-9a — the MONOTONIC guard, isolated. It runs AFTER DF-9b deliberately.
;; a later amendment (a later change) now rejects a past/present effective-at FIRST, so an
;; out-of-order timestamp that is ALSO in the past is caught by the wrong guard and
;; proves nothing about this one — that is exactly the substring-collision failure mode
;; the testing rules warn about, here between two of our OWN error strings.
;; DF-9b has just declared FUT at while the clock reads, so
;; is simultaneously IN THE FUTURE (passes Am.1) and EARLIER than the latest
;; round — which isolates the monotonic guard. Both guards keep their own falsifying negative.
;; ===========================================================================
;; 🔴 FUT (effective ) must LAND first: the design record refuses to seal a generation while
;; a declared round is still pending-effective. DF-9b above has already asserted everything it
;; needs about FUT sitting undeclared-effective, so crossing its date here costs nothing.
(env-chain-data { "chain-id": "0", "block-time": (time "2027-01-02T00:00:00Z") })
;; 🔴 THIS BLOCK NEEDS ITS OWN GENERATION. FUT already consumed the previous one, so
;; without a fresh seal `declare-round` answers "this record date already carries a
;; declared round" and — expect-failure matching by SUBSTRING — the test goes green
;; without ever reaching the MONOTONICITY check it exists to pin.
;; ---- the design record (a later change): A ROUND NEEDS A SEALED RECORD DATE ----------------------
;; Schedule one clear of the 12h runway (2 x MIN-RETRACT-LEAD), let it land, seal it.
;; The seal runs with NO KEYS on purpose: `advance-snapshot` is permissionless, and a
;; chain with no activity must still be sealable by anyone.
(begin-tx "the design record: name the record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (add-time (at 'block-time (chain-data)) 43202))
(commit-tx)
(env-chain-data
  { "chain-id": (at 'chain-id (chain-data))
, "block-time": (add-time (at 'block-time (chain-data)) 43203) })
(begin-tx "the design record: seal it")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

;; ===========================================================================
;; 🔴 DF-9a — THIS NEGATIVE IS NOW UNREACHABLE, AND THE TEST SAYS SO RATHER THAN LYING.
;;
;; It used to declare an out-of-order round and assert the MONOTONICITY refusal. Under
;; the design record that refusal can no longer fire, and the derivation is short enough to check:
;; * a round needs a FRESH generation (`declare-round`);
;; * a generation cannot SEAL while any declared round is not yet effective
;; (`schedule-snapshot`), so at the seal eff(N) <= now_seal;
;; * declaring then requires eff(N+1) > now_declare + 2 x MIN-RETRACT-LEAD, and
;; now_declare >= now_seal.
;; Therefore eff(N+1) > now_seal >= eff(N) ALWAYS. Retraction does not open a hole either:
;; it rewinds the row's effective-at to the PREVIOUS round's, which is older still.
;;
;; 🔴 THE CHECK IS NOT DELETED HERE. Removing an enforce is a design change, and a later change
;; ships the design record alone; a branch that cannot fail is a finding for a later change / an internal review,
;; recorded where the next person will look for it rather than in a commit message.
;; What IS asserted below is the property that replaced it — the ordering now holds BY
;; CONSTRUCTION — because an assertion that a refusal fires would be green-by-accident.
(begin-tx "DF-9a: effective-at ordering now holds BY CONSTRUCTION (the design record)")
(env-keys ["admin-key"])
(let ((prev-eff (at 'effective-at (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round
                     (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round-count))))
      (now (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.curr-time)))
 ;; The last declared round is already EFFECTIVE — that is what let its successor's
 ;; generation seal at all — so any future-dated declaration is necessarily later than it.
  (expect "the previous round's effective-at is already in the past" true (<= prev-eff now))
  (expect "so any legal new effective-at (> now + 12h) is strictly later than it" true
    (> (add-time now (* 2 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-RETRACT-LEAD))
       prev-eff)))
(commit-tx)

(begin-tx "DF-9a-dead: the monotonicity refusal, kept as a RECORD of what now blocks first")
(env-keys ["admin-key"])
(let ((rpt-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
      (n-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round-count)))
 ;; An earlier-dated round is still REFUSED — by the runway bound, not by monotonicity.
 ;; Asserting the message that actually fires is the point: the old expectation would have
 ;; passed by substring against a different guard entirely.
  (expect-failure "an earlier-dated round is refused — by the RUNWAY bound now"
    "effective-at must leave at least two retraction leads of runway"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "OOO" 0.01 (time "2026-12-01T00:00:00Z")))
 ;; STATE unchanged, not merely "an error fired"
  (expect "rejected declaration did not change rpt" rpt-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
  (expect "rejected declaration did not append a round" n-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round-count)))
(commit-tx)

;; ===========================================================================
