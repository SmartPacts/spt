;; ===========================================================================
;; 🔴 DF-7r — the design record'S RESIDUAL, MADE CONCRETE. THIS IS THE ONLY WAY THE POOL CAN GO
;; SHORT NOW, AND IT IS THE REASON `fund-awards` KEEPS ITS SOLVENCY GUARD.
;;
;; The declaration-time check provisions `rate * circulating AS IT IS AT DECLARATION`. The
;; round's real cost is `rate * circulating WHEN IT TAKES EFFECT`. Nothing freezes the float
;; in between: `buy`, an inbound cross-chain transfer, and — the one the operator
;; genuinely cannot prevent — a PERMISSIONLESS `release-tranche` for the founder or liquidity
;; beneficiary (the design record) all raise `circulating`. the design record names this and accepts it, because
;; an under-funded chain loses nothing: awards accumulate forever and a top-up pays them.
;;
;; So gus buys 200 SPT AFTER R5 is declared and BEFORE it is effective. He arrives at the
;; current rpt (R5 not yet folded), so he is genuinely owed 0.10 x 200 = 20 that nobody
;; provisioned. Under-funding stops being a thing an operator can simply do and becomes a
;; thing that HAPPENS TO THEM — which is the honest shape of the guarantee.
;; ===========================================================================
(begin-tx "DF-7r: the float grows between R5's declaration and its effective-at")
(env-data { "gus": { "keys": ["gus-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "gus" 100.0)] }])
(coin.transfer-create "sender00" "gus" (read-keyset 'gus) 100.0)
(env-sigs [{ "key": "gus-key", "caps": [(coin.TRANSFER "gus" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 100.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "gus" (read-keyset 'gus) 200.0)
(expect "gus holds 200 SPT, bought while R5 was declared but not yet effective" 200.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "gus"))
(commit-tx)

(begin-tx "DF-7: R5 takes effect — owed is correct, and the pool is now SHORT by gus's 20")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-03T01:00:00Z") })  ; a later amendment
;; owed is correct REGARDLESS of funding — that is the fairness half of this section:
(expect "erin owed 100*0.10 = 10 (owed set by the round, not by cash)"
  10.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "erin"))
;; ===========================================================================
;; 🔴 INVERTED BY the design record (a later change) — THIS BLOCK USED TO DEMONSTRATE THE DEFECT, AND NOW
;; DEMONSTRATES THE FIX. It asserted "gus owed 20 — real money nobody provisioned" and "the
;; pool is now short by exactly that 20": the float grew between R5's declaration and its
;; effective-at, so the chain owed more than the bar it had been funded against. That is
;; precisely the 150 % shortfall the design record was written to close, and it is the reason
;; `claim-awards` being ALL-OR-NOTHING made it a race an honest holder could lose.
;;
;; Under the design record gus buys AFTER the record instant, so he is owed NOTHING and the pool is not
;; short by a trillionth. The assertions are INVERTED, not deleted — a suite that quietly
;; dropped them would lose the only place this failure mode is written down.
(expect "🔴 gus bought INSIDE the window, so the design record owes him nothing" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "gus"))
(expect "erin, who held at the record instant, is still owed her full 10" 10.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "erin"))
(expect "🔴 AND THE POOL IS NOT SHORT — the denominator could not move under the round" true
  (<= (- (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)
         (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
      0.0))
(commit-tx)

(begin-tx "DF-7: under-funding is REJECTED by the solvency guard (protects late claimers)")
(env-keys ["admin-key"])
;; pool must cover the chain's TRUE liability now. A tiny deposit is rejected.
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT 1.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" 1.0)
(env-keys ["admin-key"])
;; 🔴 THE UNDER-FUND NEGATIVE IS NO LONGER REACHABLE BY THIS ROUTE, and that is a FINDING,
;; not a tidy-up. `fund-awards`' guard fires when pool + deposit < floor(liability); the design record
;; makes `declare-round` fund the EXACT debt against a float that cannot move afterwards, so
;; on this path the pool always covers. The deposit below therefore SUCCEEDS where it used to
;; be refused.
;; 🔴 IT IS NOT REMOVED FROM THE MODULE. Deleting an enforce is a design change and a later change
;; ships the design record alone — whether `fund-awards` retains a reachable failing branch belongs to
;; a later change / an internal review, recorded here where the next person will look. `fund-awards`
;; keeps its own guard as the recoverable top-up path either way (the design record says so explicitly).
(expect "a top-up is now ACCEPTED — the pool already covers the debt" "awards funded"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards 1.0))
(commit-tx)

(begin-tx "DF-7: a sufficient top-up satisfies solvency; erin can then claim")
(env-keys ["admin-key"])
;; fund to the EXACT liability (not circ*rpt) — this is the number the ops tool computes.
(let* ((liability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
       (poolbal (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
       (need (- liability poolbal))
 ;; 🔴 CLAMPED. Under the design record the pool can arrive at this point ALREADY covering the
 ;; liability (measured here: liability 900.0, pool 901.0), because `declare-round`
 ;; sizes against the SEALED float rather than the live one — over-funding is
 ;; permitted and recoverable, and it is not what this block is testing. Without the
 ;; clamp `need` goes negative, `topup` lands on 0.0 and `receive-funding` aborts
 ;; "amount must be positive" — a suite failing on its own arithmetic rather than on
 ;; the solvency guard it exists to exercise.
       (topup (if (> need 0.0) (+ need 1.0) 1.0)))
  (print (format "DF-7 solvency: liability={} pool={} need={} topup={}" [liability poolbal need topup]))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT topup)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" topup)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards topup))
;; erin claims her exact owed amount now that the pool is solvent.
(let ((owed (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "erin")))
  (expect "erin claim pays exactly her owed amount" owed
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "erin"))
  (expect "erin pending 0 after claim" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "erin")))
(commit-tx)

;; ===========================================================================
;; DF-8 — SINGLE-CHAIN LIABILITY GAP made concrete (the exact case circ*rpt missed).
;; A holder that has ACCRUED pending then sends its tokens to an EXCLUDED account
;; (treasury) drops circulating while its crystallized pending stays claimable. Now
;; circ*rpt UNDER-counts the true liability by exactly that stranded pending, and the
;; OLD guard would have let the operator fund too little. The tightened guard rejects it.
;; ===========================================================================
(begin-tx "DF-8 set up a holder with accrued pending, then dump tokens to treasury")
;; give a fresh holder frank 1000 from alice (alice holds 1500 now: 2000-500 to carol).
(env-data { "frank": { "keys": ["frank-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "frank" 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "alice" "frank" (read-keyset 'frank) 1000.0)
(commit-tx)

;; frank arrived at the current global rpt -> 0 pending. Declare a fresh round so frank
;; accrues real pending on his 1000 tokens. the design record: provision it first.
(begin-tx "the design record: provision the pool for R6 (0.05)")
(env-keys ["admin-key"])
(let ((need (- (floor (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
                         (* 0.05 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
                      12)
               (try 0.0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))))
  (expect "R6 is not already covered — this provisioning is doing real work" true (> need 0.0))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

