(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

(begin-tx "DF-9d: retroactive and present-dated rounds are rejected")
(env-keys ["admin-key"])
(let ((rpt-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
      (n-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round-count))
      (now (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.curr-time)))
  (expect-failure "PAST effective-at rejected" "effective-at must leave at least two retraction leads of runway"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "RETRO" 0.02 (time "2026-06-01T00:00:00Z")))
  (expect-failure "PRESENT effective-at rejected (the == boundary)"
    "effective-at must leave at least two retraction leads of runway"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "NOW" 0.02 now))
  (expect "no rpt movement from either rejection" rpt-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
  (expect "no round appended by either rejection" n-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round-count)))
;; NOTE: no "and a future round is accepted" positive is added here on purpose — every other
;; round in this suite already is one, and declaring an extra round at this point would shift
;; the pinned rpt arithmetic in DF-9c/DF-10 (measured: it read 0.31 where 0.30 is asserted).
(commit-tx)

(begin-tx "DF-9c: when the future round becomes effective, it folds ONCE (not on top of a doubled base)")
;; advance time past the future round; rpt rises by exactly 0.07 — from the pinned 0.23 to
;; exactly 0.30, once, never double (a doubled fold would read 0.37+).
(env-chain-data { "chain-id": "0", "block-time": (time "2027-06-01T00:00:00Z") })
(expect "FUT now effective: rpt == 0.23 + 0.07 == 0.30 exactly (added once)"
  0.30 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.apply-round "fut-now")
(expect "rpt materialized once, still exactly 0.30" 0.30
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect-failure "no further rounds to apply (idempotent)"
  "no newly-effective rounds to apply"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.apply-round "z"))
(expect "rpt still exactly 0.30 after the rejected re-apply (no inflation, hard number)" 0.30
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(commit-tx)

;; ===========================================================================
;; DF-10 — PRECISION REGRESSION (cold double-check HIGH): a payout finer than 12
;; decimals used to BRICK claim-awards forever (coin refuses sub-12dp transfers;
;; the raw accrual product bal*(rpt-rd) carries up to 24dp). Fix: pay the 12dp
;; FLOOR, carry the dust (<1e-12) as pending. Assert: the claim PAYS, the dust is
;; preserved, liability == Σ pending stays EXACT, and the next round sweeps dust.
;; ===========================================================================
(begin-tx "the design record: provision the pool for R7 (1e-7)")
(env-keys ["admin-key"])
(let ((need (- (floor (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
                         (* 0.0000001 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
                      12)
               (try 0.0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))))
  (if (> need 0.0)
    (let ((_ 0))
      (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
      (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
      (env-keys ["admin-key"])
      (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
    "already covered"))
(commit-tx)

(begin-tx "DF-10 fractional holder + fine-grained rate -> 13-decimal owed")
(env-data { "grace": { "keys": ["grace-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "grace" 123.456789)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "alice" "grace" (read-keyset 'grace) 123.456789)
(commit-tx)

