(begin-tx "DF-10 invariant holds with sub-precision values; fund to floored liability")
(env-data { "all-accts": ["alice" "bob" "carol" "dave" "eve" "bob-a" "bob-b" "erin" "frank" "grace" "gus"] })
(let ((liab (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
      (sum-pend (fold (+) 0.0
                  (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                       (read-msg 'all-accts)))))
  (expect "liability == Σ pending EXACT even with 13-decimal terms" sum-pend liab))
(env-keys ["admin-key"])
(let* ((liab (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
       (poolbal (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
       (topup (- (+ (floor liab 12) 0.000000000001) poolbal)))  ; fund to exactly floor12(L)+1e-12
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT topup)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" topup)
  (env-keys ["admin-key"])
 ;; the guard now compares against floor12(L) — fundable with a clean 12dp amount
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards topup))
(commit-tx)

