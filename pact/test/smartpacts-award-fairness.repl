(begin-tx "DF-8 frank dumps all 1000 tokens to an EXCLUDED account -> circulating drops, pending stays")
;; a later change M-1: the destination changed from TREASURY-ACCOUNT to the launch reserve, and the
;; reason matters. The three TRANCHE reserves can no longer RECEIVE — a deposit there would be
;; permanently destroyed (debit refuses every exit and release-tranche is capped by the lock's
;; immutable `total`), so the transfer is refused outright. The launch reserve is the excluded
;; account that can still legitimately receive: its exit is `buy`, so a deposit there
;; is sellable rather than stranded. The PROPERTY under test is unchanged — a holder moving
;; tokens to an `excluded?` account drops circulating and keeps their crystallized pending.
;; the O(n) truth: Σ pending-awards-of over every float account touched in this suite
(env-data { "float-accts": ["alice" "bob" "carol" "dave" "eve" "bob-a" "bob-b" "erin" "frank" "gus"] })
(let ((circ-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
      (liab-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
      (sum-pending-before (fold (+) 0.0
        (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
             (read-msg 'float-accts)))))
 ;; the O(1) counter matches the O(n) truth BEFORE the dump
  (expect "award-liability == Σ pending-of (before dump)" sum-pending-before liab-before)
  (env-sigs [{ "key": "frank-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "frank" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "frank" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)
 ;; frank keeps his 50 crystallized; treasury (excluded) accrues nothing.
  (expect "frank still owed 50 after dumping tokens" 50.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "frank"))
  (let* ((circ-after (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
         (liab-after (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
         (rpt (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
         (circ-rpt (* circ-after rpt)))
    (print (format "DF-8 GAP: circ {}->{} liability {}->{} ; circ*rpt={} true-liability={}"
      [circ-before circ-after liab-before liab-after circ-rpt liab-after]))
    (expect "circulating dropped by 1000 (frank's tokens left the float)" (- circ-before 1000.0) circ-after)
 ;; liability is INVARIANT across a holder->excluded move: the earned 50 is preserved, not lost
    (expect "liability unchanged by the dump (earned award preserved)" liab-before liab-after)
 ;; the O(1) counter STILL matches the O(n) truth AFTER the dump
    (expect "award-liability == Σ pending-of (after dump)"
      (fold (+) 0.0
        (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
             (read-msg 'float-accts)))
      liab-after)
 ;; THE BLIND SPOT: true liability now strictly EXCEEDS circ*rpt -> the old guard would under-fund
    (expect "liability strictly exceeds circ*rpt (the old guard's blind spot)" true (> liab-after circ-rpt))))
(commit-tx)

(begin-tx "DF-8 the OLD guard's amount (circ*rpt) is now REJECTED; funding to liability succeeds")
(env-keys ["admin-key"])
(let* ((circ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
       (rpt (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
       (liability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
       (poolbal (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
       (old-amt (- (* circ rpt) poolbal))   ; what the OLD circ*rpt guard would have accepted
       (true-amt (+ (- liability poolbal) 0.01)))
 ;; fund the funding account enough for the true amount
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT true-amt)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" true-amt)
  (env-keys ["admin-key"])
 ;; 🔴 THE `expect-failure` ON `old-amt` THAT STOOD HERE IS RELOCATED, NOT DELETED, AND THE
 ;; REASON IS STRUCTURAL RATHER THAN COSMETIC. It funded `circ*rpt - pool` and required a
 ;; refusal. Post-the design record the pool ALREADY covers the liability at every declaration, so
 ;; `circ*rpt - pool` is NEGATIVE here (measured: circ*rpt 966, pool ~1170) and
 ;; fund-awards refuses it with "pool-amount must be positive" — a green test asserting
 ;; the wrong branch, which is the exact false-green shape this suite's own header warns
 ;; about. Staging a real shortfall does not rescue it either: the only way the pool can go
 ;; short now is the the design record residual (float growth between declaration and effect), and the
 ;; new holder that growth creates carries a fresh reward-debt, which inflates `circ*rpt`
 ;; ABOVE the liability and destroys the very blind spot this section exists to demonstrate.
 ;; The two properties are not co-stageable any more. So they are split:
 ;; * THE BLIND SPOT (liability strictly exceeds circ*rpt) stays here, asserted above, and
 ;; is the finding this section was written for.
 ;; * THE REFUSAL of an under-funding deposit is pinned where it is now reachable — DF-7r
 ;; above (measured: pool 900 against a 920 liability, `fund-awards 1.0` refused) and
 ;; smartpacts-solvency-at-declaration.repl §C. Neither is a name-pin; both enter the function.
  (expect "the blind spot is real: funding only to circ*rpt would leave frank stranded" true
    (< (* circ rpt) liability))
  (expect "and it is unreachable as an operator ACTION now — the design record pre-covered the pool" true
    (< old-amt 0.0))
 ;; funding to the TRUE liability succeeds
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards true-amt))
;; and frank can now claim his full 50
(expect "frank claims his stranded 50 in full" 50.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "frank"))
(commit-tx)

;; ===========================================================================
;; DF-9 — AUDITOR REGRESSION (the CRITICAL): out-of-order round declaration.
;; The bug: apply-round folded Σ of ALL effective-but-unapplied rates but advanced
;; rounds-applied only to the last CONSECUTIVE effective index. If a FUTURE round sat
;; at a lower index than an EFFECTIVE round, the effective round's rate was folded into
;; rpt yet never advanced past -> re-counted on every later apply-round (permanent rpt
;; inflation, permissionless). Fix: (a) declare-round enforces non-decreasing effective-at
;; (so index order == time order == no gaps); (b) apply-round folds+advances the SAME
;; consecutive-effective prefix, never folding a rate it does not advance past.
;; ===========================================================================
(begin-tx "the design record: provision the pool for FUT (0.07)")
(env-keys ["admin-key"])
(let ((need (- (floor (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
                         (* 0.07 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
                      12)
               (try 0.0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))))
  (expect "FUT (0.07) is not already covered — this provisioning is doing real work" true (> need 0.0))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

