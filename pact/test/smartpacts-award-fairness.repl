(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

(begin-tx "DF-10 next round SWEEPS the dust into a payable claim")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "R8" 0.1 (time "2027-06-03T12:00:00Z"))
(env-chain-data { "chain-id": "0", "block-time": (time "2027-06-03T12:00:00Z") })  ; a later amendment
;; grace raw = dust 9e-13 + 123.456789*0.1 = 12.3456789000009 -> pays 12.345678900000, dust 9e-13 again
(env-keys ["admin-key"])
(let* ((liab (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
       (poolbal (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
       (topup (- (+ (floor liab 12) 0.000000000001) poolbal)))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT topup)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" topup)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards topup))
(expect "grace claim pays 12.345678900000 (old dust included in raw, re-floored)"
  12.345678900000 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "grace"))
(expect "dust again 9e-13 (carried, never lost)"
  0.0000000000009 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "grace"))
(commit-tx)

;; ===========================================================================
;; DF-11 — FIFTH-PASS REGRESSION (MED-1): fundability at circ = 0.
;; Amendment 1 exists to keep the crystallized pending of DEPARTED tokens payable;
;; but the old (> circ 0.0) gate refused the module's own funding path at the exact
;; boundary it was built for: every holder exits (a dump to the excluded treasury
;; is the same counter path as a cross-chain exit's step-0 debit) -> circ = 0 with
;; pending stranded and UNfundable through fund-awards. Amendment 4: fundable
;; iff circ > 0 OR floor12(L) > 0. Only a DEAD chain (circ = 0 AND nothing payable)
;; is refused, so cash can never be parked in the no-exit pool for no one.
;; ===========================================================================
(begin-tx "DF-11 every remaining holder exits to the excluded treasury -> circ = 0")
;; each holder dumps their FULL balance (scoped sigs — managed TRANSFER caps need
;; exact amounts; the suite is deterministic so the literals are the live balances).
;; bob-a and frank are already at 0 (drained/dumped earlier in the suite).
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 276.543211)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 276.543211)
(env-sigs [{ "key": "bob-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)
(env-sigs [{ "key": "bob-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "bob-b" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "bob-b" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)
(env-sigs [{ "key": "carol-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "carol" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "carol" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 500.0)
(env-sigs [{ "key": "dave-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "dave" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "dave" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 1000.0)
(env-sigs [{ "key": "erin-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "erin" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 100.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "erin" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 100.0)
(env-sigs [{ "key": "grace-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "grace" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 123.456789)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "grace" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 123.456789)
(env-sigs [{ "key": "gus-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "gus" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 200.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "gus" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve) 200.0)
(expect "circulating is now ZERO" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(env-data { "all-accts": ["alice" "bob" "carol" "dave" "bob-a" "bob-b" "erin" "frank" "grace" "gus"] })
(let ((l (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
      (sum-pend (fold (+) 0.0
                  (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                       (read-msg 'all-accts)))))
  (expect "liability == Σ pending EXACT at circ=0 (stranded pending)" sum-pend l)
  (expect "a payable liability is stranded here" true (> (floor l 12) 0.0)))
(commit-tx)

(begin-tx "DF-11 fund-awards WORKS at circ=0 (the fifth-pass MED-1 regression)")
(let* ((l (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
       (poolbal (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT))
       (short (- (+ (floor l 12) 0.000000000001) poolbal))
       (dep (if (> short 1.0) short 1.0)))   ; top up any shortfall; at least 1 KDA to exercise the path
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT dep)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" dep)
  (env-keys ["admin-key"])
 ;; pre-fix this aborted with "no circulating float" — the designed funding path
 ;; refused the exact boundary Amendment 1 was built for
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards dep))
(let ((l (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
      (poolbal (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))
  (expect "pool covers the full stranded liability" true (>= poolbal (floor l 12))))
(commit-tx)

;; each claim in its OWN tx (as on-chain): bob/bob-a/bob-b token one guard, so their
;; recipient principal and payout collide as a managed coin.TRANSFER install if
;; claimed inside a single tx — a REPL-session artifact, not a contract property.
(begin-tx "DF-11 claim alice")
(let ((p (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "alice")))
  (if (> (floor p 12) 0.0) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "alice") 0.0))
(commit-tx)
