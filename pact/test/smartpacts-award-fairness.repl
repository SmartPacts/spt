;; ===========================================================================
;; SPT AWARD-FAIRNESS suite (the design record — globally-correct accrual).
;;
;; This suite proves the fairness properties of the DECLARED-ROUND global rpt.
;; The event surfaced a real bug: with a PER-CHAIN rpt bumped by fund-awards,
;; a token moving between chains during a round was double-paid or under-paid,
;; because it re-based to the LOCAL chain's rpt. the design record makes the rpt a single
;; deterministic value (Σ rate over declared rounds effective-at <= now), so a
;; balance change on ANY account/chain checkpoints against the SAME baseline.
;;
;; Cross-chain SPV is DEVNET-only and cannot run in the bare REPL. But the FIX is
;; chain-agnostic: the failure was "a moving balance re-bases to a different rpt."
;; In-REPL we reproduce exactly that — move a balance between accounts across the
;; round boundary and assert the payout equals rate * balance-held-at-round-time,
;; regardless of when/where the balance moved. Whether two accounts are on one
;; chain or twenty is irrelevant to the arithmetic once the rpt is global; the
;; devnet suite (test/harness) then confirms the same holds across real chains.
;; ===========================================================================
(load "setup.repl")

;; ---------------------------------------------------------------------------
;; Seed float via the launch: alice 3000, bob 2000 (circulating 5000).
;; ---------------------------------------------------------------------------
(begin-tx "activate launch + seed alice 3000 / bob 2000")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.init 0.5)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.resume-sale)
(env-data { "alice": { "keys": ["alice-key"], "pred": "keys-all" }
       , "bob":   { "keys": ["bob-key"],   "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "alice" 1500.0) (coin.TRANSFER "sender00" "bob" 1000.0)] }])
(coin.transfer-create "sender00" "alice" (read-keyset 'alice) 1500.0)
(coin.transfer-create "sender00" "bob"   (read-keyset 'bob)   1000.0)
(env-sigs [{ "key": "alice-key", "caps": [(coin.TRANSFER "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "alice" (read-keyset 'alice) 3000.0)
(env-sigs [{ "key": "bob-key", "caps": [(coin.TRANSFER "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "bob" (read-keyset 'bob) 2000.0)
(expect "circulating 5000" 5000.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(expect "rpt starts at 0" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(commit-tx)

;; ===========================================================================
;; the design record (a later change) — PROVISIONING. `declare-round` now refuses unless this chain's pool
;; already covers floor12(declared-liability + rate*circulating), so every round below is
;; paid for before it is promised. The amount is COMPUTED from the contract rather than
;; hardcoded: a literal would silently stop being the bar the module enforces, and this
;; suite's whole subject is that the accounting is exact.
;;
;; Each provisioning runs in its OWN transaction, and so does the declaration that follows.
;; That is not style: `fund-awards` calls `install-capability`, and Pact 5 disables
;; UNSCOPED signatures for the remainder of any transaction in which one has run
;; (checkSigCaps — pact-5 Pact/Core/Environment/Utils.hs:126-139, "if you installed a
;; capability from code then we disable unscoped sigs"). Measured: fund-then-declare under
;; `env-keys` in one tx fails inside ADMIN with a bare `Keyset failure`, re-issuing
;; `env-keys` does NOT clear it, and a signature SCOPED to FUND-AWARDS + ADMIN works.
;; ===========================================================================
(begin-tx "the design record: provision the pool for R1 (0.02 x 5000 float = 100 KDA)")
(env-keys ["admin-key"])
(let ((need (- (floor (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
                         (* 0.02 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
                      12)
               (try 0.0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))))
  (expect "R1 costs exactly 100 KDA at this float" 100.0 need)
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

;; ===========================================================================
;; DF-1 — DOUBLE-PAY case is CLOSED.
;; Old bug: fund source chain (rpt 0->2); Bob moves 10 A->B (B.rpt still 0):
;; debit A pending += 10*(2-0)=20; credit B reward-debt = LOCAL B.rpt = 0;
;; then fund B (rpt 0->2): B accrues another 10*(2-0)=20 -> claim 40, fair 20.
;; New model: rpt is GLOBAL = 2 the instant the round is effective. Bob moving
;; A->B crystallizes 20 on the source and arrives at reward-debt = global 2, so
;; the destination accrues 10*(2-2)=0. Total = 20 = fair. We model A and B as
;; two accounts (bob-a, bob-b) that the SAME owner controls; the invariant is on
;; the OWNER's total across both.
;; ===========================================================================
;; 🔴 the design record: one generation per round, and a new one cannot be sealed while the
;; previous round is still pending-effective — so each round below is preceded by its
;; own record date. The rounds' effective-ats moved by 1-2h (and R7/R8 by 12h) to clear
;; the 12h seal plus the 12h declaration runway; the CADENCE is unchanged and every
;; payout assertion is untouched.
(begin-tx "DF-1 setup: give bob-a 1000 (from alice), declare a round, make it effective")
;; move 1000 from alice -> bob-a BEFORE any round (rpt 0, no accrual to inherit)
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "bob-a" 1000.0)] }])
(env-data { "bob-a": { "keys": ["bob-key"], "pred": "keys-all" }
       , "bob-b": { "keys": ["bob-key"], "pred": "keys-all" } })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "alice" "bob-a" (read-keyset 'bob-a) 1000.0)
(expect "bob-a holds 1000" 1000.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "bob-a"))
(commit-tx)

;; 🔴 THE SEAL COMES AFTER THE HOLDINGS, AND THAT ORDER IS THE WHOLE POINT OF the design record.
;; Sealed before bob-a's 1000 arrives he holds NOTHING at the record instant and is owed
;; nothing — measured here as `pending 0.0` where this suite asserts 20.0. That is the module
;; behaving correctly, not a defect: float arriving after the record instant is free.
;; ---- the design record (a later change): A ROUND NEEDS A SEALED RECORD DATE ----------------------
;; Schedule one clear of the 12h runway (2 x MIN-RETRACT-LEAD), let it land, seal it.
;; The seal runs with NO KEYS on purpose: `advance-snapshot` is permissionless, and a
;; chain with no activity must still be sealable by anyone.
(begin-tx "the design record: name the record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (add-time (at 'block-time (chain-data)) 43202))
(commit-tx)
(env-chain-data
  { "chain-id": (at 'chain-id (chain-data))
, "block-time": (add-time (at 'block-time (chain-data)) 43203) })
(begin-tx "the design record: seal it")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

(begin-tx "DF-1 setup (cont): declare R1 against the sealed float")
;; declare round R1 rate 0.02 effective 1h out (a later amendment) -> global rpt 0.02 once crossed
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "R1" 0.02 (time "2026-06-02T04:00:00Z"))
(expect "declared but not yet effective: rpt 0" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-02T04:00:00Z") })
(expect "global rpt 0.02 (round effective everywhere at once)" 0.02 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
;; fund enough to cover circulating*rpt = 5000*0.02 = 100
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT 100.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" 100.0)
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards 100.0)
(expect "bob-a accrued 1000*0.02 = 20 pending" 20.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-a"))
(commit-tx)

(begin-tx "DF-1: bob moves his 1000 A->B AFTER the round is effective (the double-pay trigger)")
;; This is the exact old-bug move: transfer during/after a funded round. Under the
;; OLD per-chain rpt this re-based bob-b to a fresh 0 and double-paid on the next fund.
(env-sigs [{ "key": "bob-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "bob-a" "bob-b" 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "bob-a" "bob-b" (read-keyset 'bob-b) 1000.0)
;; debit A crystallized the 20; credit B arrives at the GLOBAL rpt 0.02, delta 0.
(expect "bob-a pending crystallized = 20 (kept on source)" 20.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-a"))
(expect "bob-b pending = 0 (arrived at global rpt; no phantom re-accrual)" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-b"))
;; THE FAIRNESS ASSERTION: owner's total across both accounts = 20 = rate*balance = fair.
;; (Under the old bug this would read 40 after a second fund. It cannot here.)
(expect "owner total = 20 (paid exactly once — double-pay CLOSED)"
  20.0
  (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-a")
     (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-b")))
(commit-tx)

;; ===========================================================================
;; DF-1b — EXACT SOLVENCY liability counter tracks TRUE owed, incl. crystallized
;; pending on tokens whose balance dropped. award-liability == Σ pending-of all
;; float accounts, always. This is what fund-awards must cover (not circ*rpt).
;; ===========================================================================
(begin-tx "DF-1b exact liability == Σ pending across all float accounts")
;; float accounts so far: alice(2000), bob(2000), bob-a(0,+20 pending), bob-b(1000)
(let ((liability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
      (sum-pend (fold (+) 0.0
                  (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                       ["alice" "bob" "bob-a" "bob-b"]))))
  (print (format "DF-1b: award-liability={} Σpending={}" [liability sum-pend]))
  (expect "award-liability == Σ pending-of (exact O(1) == O(n) truth)" sum-pend liability))
;; circulating*rpt = 5000*0.02 = 100, but bob-a holds 20 crystallized while contributing
;; 0 to circulating (balance 0) -> liability (100) still == circ*rpt here because bob-a's
;; 20 is offset by bob-b arriving at rpt (owed 0). The GAP appears when a departed token's
;; crystallized pending is NOT regenerated by circulating -> proven on devnet (cross-chain).
(expect "circulating unchanged at 5000 (holder->holder)" 5000.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(commit-tx)

(begin-tx "DF-1: a SECOND fund on the destination does NOT re-pay the moved token")
;; The old double-pay needed a later fund on the target to bump its local rpt again.
;; Here rpt is global and already 0.02 for this round; funding more cash cannot raise
;; what is OWED (only declare-round can), so bob-b stays at 0 for this round.
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT 100.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" 100.0)
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards 100.0)  ; pool top-up, rpt unchanged
(expect "global rpt STILL 0.02 (funding never moves owed)" 0.02 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "bob-b STILL 0 (no double-pay from a later fund)" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-b"))
(expect "owner total STILL 20" 20.0
  (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-a")
     (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob-b")))
(commit-tx)

;; ===========================================================================
;; DF-2 — UNDERPAY case is CLOSED.
;; Old bug: destination chain already had rpt 2; a token moving in re-based to
;; reward-debt = 2, then the source got funded while the token was gone -> claim 0.
;; New model: there is no per-chain head start; the rpt is one value. A token that
;; is present when a NEW round becomes effective earns that round in full wherever
;; it sits. We prove: carol receives tokens (before round 2), round 2 is declared,
;; carol earns round 2 fully even though she was never on the "source".
;; ===========================================================================
(begin-tx "DF-2 setup: carol buys in AFTER round 1, before round 2")
(env-data { "carol": { "keys": ["carol-key"], "pred": "keys-all" } })
;; alice sends carol 500 (alice currently holds 3000-1000 = 2000). rpt is 0.02 now,
;; so carol arrives at reward-debt 0.02 -> she earns NOTHING from round 1 (correct:
;; she wasn't a holder when round 1 was declared-and-effective at time she held 0).
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "carol" 500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "alice" "carol" (read-keyset 'carol) 500.0)
(expect "carol pending 0 after round 1 (joined late — no retroactive round-1 pay)" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "carol"))
(commit-tx)

;; ---- the design record (a later change): A ROUND NEEDS A SEALED RECORD DATE ----------------------
;; Schedule one clear of the 12h runway (2 x MIN-RETRACT-LEAD), let it land, seal it.
;; The seal runs with NO KEYS on purpose: `advance-snapshot` is permissionless, and a
;; chain with no activity must still be sealable by anyone.
(begin-tx "the design record: name the record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (add-time (at 'block-time (chain-data)) 43202))
(commit-tx)
(env-chain-data
  { "chain-id": (at 'chain-id (chain-data))
, "block-time": (add-time (at 'block-time (chain-data)) 43203) })
(begin-tx "the design record: seal it")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

(begin-tx "DF-2: declare round 2 -> carol earns round 2 in full (no underpay)")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "R2" 0.02 (time "2026-06-03T08:00:00Z"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T08:00:00Z") })  ; a later amendment
(expect "global rpt now 0.04 (two rounds)" 0.04 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "carol earns 500*0.02 = 10 for round 2 (full, not underpaid)" 10.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "carol"))
(commit-tx)

;; ===========================================================================
;; DF-3 — MOVE-BEFORE-ROUND: a holder that moves before a round is effective earns
;; the round at the DESTINATION (weight follows the tokens, not the origin).
;; ===========================================================================
(begin-tx "DF-3: dave gets tokens before round 3, holds through it")
(env-data { "dave": { "keys": ["dave-key"], "pred": "keys-all" } })
;; bob (holder, 2000) sends dave 1000 while rpt is 0.04 (no new round yet declared).
(env-sigs [{ "key": "bob-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "bob" "dave" 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "bob" "dave" (read-keyset 'dave) 1000.0)
(expect "dave pending 0 on arrival" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "dave"))
(commit-tx)

;; 🔴 SEAL AFTER DAVE'S TOKENS LAND. Sealed first he holds nothing at the record instant and
;; R3 pays him nothing — measured 0.0 where this block asserts 10.0. "The round follows the
;; tokens" is still true; under the design record it follows the tokens held AT THE RECORD INSTANT.
;; ---- the design record (a later change): A ROUND NEEDS A SEALED RECORD DATE ----------------------
;; Schedule one clear of the 12h runway (2 x MIN-RETRACT-LEAD), let it land, seal it.
;; The seal runs with NO KEYS on purpose: `advance-snapshot` is permissionless, and a
;; chain with no activity must still be sealable by anyone.
(begin-tx "the design record: name the record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (add-time (at 'block-time (chain-data)) 43202))
(commit-tx)
(env-chain-data
  { "chain-id": (at 'chain-id (chain-data))
, "block-time": (add-time (at 'block-time (chain-data)) 43203) })
(begin-tx "the design record: seal it")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

(begin-tx "DF-3 (cont): declare R3 against the sealed float")
;; declare round 3 -> dave, present now, earns it fully at the destination.
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "R3" 0.01 (time "2026-06-04T12:00:00Z"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-04T12:00:00Z") })  ; a later amendment
(expect "dave earns 1000*0.01 = 10 (round follows the tokens)" 10.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "dave"))
(commit-tx)

;; ===========================================================================
;; DF-4 — EFFECTIVE-AT gating: a FUTURE-dated round does not accrue until its
;; timestamp passes. get-rpt must not include it early; time-advance flips it on.
;; ===========================================================================
(begin-tx "the design record: provision the pool for R4 (0.03)")
(env-keys ["admin-key"])
(let ((need (- (floor (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
                         (* 0.03 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
                      12)
               (try 0.0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))))
  (expect "R4 (0.03) is not already covered — this provisioning is doing real work" true (> need 0.0))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

;; ---- the design record (a later change): A ROUND NEEDS A SEALED RECORD DATE ----------------------
;; Schedule one clear of the 12h runway (2 x MIN-RETRACT-LEAD), let it land, seal it.
;; The seal runs with NO KEYS on purpose: `advance-snapshot` is permissionless, and a
;; chain with no activity must still be sealable by anyone.
(begin-tx "the design record: name the record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (add-time (at 'block-time (chain-data)) 43202))
(commit-tx)
(env-chain-data
  { "chain-id": (at 'chain-id (chain-data))
, "block-time": (add-time (at 'block-time (chain-data)) 43203) })
(begin-tx "the design record: seal it")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(commit-tx)

(begin-tx "DF-4: declare a FUTURE round; rpt must not move yet")
(env-keys ["admin-key"])
(expect "rpt 0.05 before future round (0.02+0.02+0.01)" 0.05 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round "R4" 0.03 (time "2026-09-01T00:00:00Z"))
(expect "rpt UNCHANGED at 0.05 (future round not yet effective)" 0.05 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "dave pending unchanged (future round not accruing)" 10.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "dave"))
(commit-tx)

(begin-tx "DF-4: advance block-time past the future round -> it becomes effective")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-02T00:00:00Z") })
(expect "rpt now 0.08 (future round R4 became effective)" 0.08 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "dave now earns R3+R4 = 1000*(0.01+0.03) = 40" 40.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "dave"))
(commit-tx)

;; ===========================================================================
;; DF-5 — apply-round MATERIALIZES the rpt: get-rpt identical before/after, and
;; apply-round is idempotent (second call is a no-op / rejects "nothing to apply").
;; ===========================================================================
(begin-tx "DF-5: apply-round folds effective rounds into stored rpt; value unchanged")
(env-keys ["admin-key"])
(let ((before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)))
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.apply-round "R4")
  (expect "get-rpt identical after apply-round (materialization is transparent)"
    before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)))
(expect "dave pending unchanged by apply-round" 40.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "dave"))
;; idempotent: nothing new is effective-and-unapplied now, so a re-apply must reject.
(expect-failure "apply-round idempotent (no newly-effective rounds)"
  "no newly-effective rounds to apply"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.apply-round "R4"))
(commit-tx)

;; ===========================================================================
;; DF-6 — CONSERVATION / general invariant: Σ claims == Σ (rate * float held)
;; and Σ claims <= Σ funded. Reset to a clean time and run one clean round with
;; churn, then claim everyone and check the pool math.
;; ===========================================================================
(begin-tx "DF-6: sum of all pendings equals rate-weighted float (post all rounds)")
;; Effective rounds so far: R1 0.02, R2 0.02, R3 0.01, R4 0.03 (all effective at ).
;; Holders and the rounds each was present-and-holding for determine owed amounts.
;; We assert the GLOBAL conservation identity instead of re-deriving each holder:
;; total owed (pending + claimable) across every float account == Σ over holders of
;; balance*(global_rpt - reward_debt) + pending. We compute it directly from the API.
(let* ((rpt (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
       (accts ["alice" "bob" "carol" "dave" "bob-a" "bob-b"])
       (owed (fold (+) 0.0
               (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                    accts))))
  (print (format "DF-6: global rpt={} total owed across float holders={}" [rpt owed]))
 ;; CONSERVATION: total owed must equal Σ over holders of (balance * global_rpt that the
 ;; holder was present for). With circulating 5000 and every current float unit having
 ;; accrued the full rpt 0.08 (either as pending crystallized on a debit or as live
 ;; balance*(rpt-debt)), the rate-weighted float is 5000 * 0.08 = 400 — no more (no
 ;; double-pay), no less (no strand). Exact, not "positive".
  (expect "total owed == circulating * rpt == 5000 * 0.08 == 400 (conservation, exact)"
    400.0 owed))
(commit-tx)

;; ===========================================================================
;; DF-7 — SOLVENCY is decoupled from FAIRNESS: an under-funded chain still OWES
;; the correct amount; funding only governs whether the cash is present. A holder
;; can still see the right pending even if the pool can't pay yet; a top-up pays.
;; ===========================================================================
(begin-tx "DF-7: erin joins before R5")
;; a fresh clean holder for an isolated solvency check
(env-data { "erin": { "keys": ["erin-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "erin" 100.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "alice" "erin" (read-keyset 'erin) 100.0)
(commit-tx)

(begin-tx "the design record: provision the pool for R5 (0.10)")
(env-keys ["admin-key"])
(let ((need (- (floor (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
                         (* 0.10 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
                      12)
               (try 0.0 (coin.get-balance n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.POOL-ACCOUNT)))))
  (expect "R5 is not already covered — this provisioning is doing real work" true (> need 0.0))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

