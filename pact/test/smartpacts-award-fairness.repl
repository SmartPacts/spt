  0.0000000000009 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "grace"))
;; invariant still EXACT after a dust-carrying claim
(env-data { "all-accts": ["alice" "bob" "carol" "dave" "eve" "bob-a" "bob-b" "erin" "frank" "grace" "gus"] })
(let ((liab (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
      (sum-pend (fold (+) 0.0
                  (map (lambda (a:string) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                       (read-msg 'all-accts)))))
  (expect "liability == Σ pending EXACT after dust-carrying claim" sum-pend liab))
