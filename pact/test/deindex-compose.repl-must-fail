(begin-tx "foreign attacker module")
(env-data { "evil": { "keys": ["attacker"], "pred": "keys-all" } })
(env-keys ["attacker"])
(define-namespace "dxns" (read-keyset 'evil) (read-keyset 'evil))
(namespace "dxns")
(define-keyset "dxns.ks" (read-keyset 'evil))
(module dx GOV
  (defcap GOV () (enforce-keyset "dxns.ks"))
 ;; THE ESCAPE: LIFECYCLE's body asserted only that the proposal is active, which the
 ;; attacker is happy to satisfy — so composing it cost nothing and granted everything.
  (defcap HOLD-LC (id:string)
    (compose-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.LIFECYCLE id)))
  (defun pop (id:string slot:integer)
    (with-capability (HOLD-LC id)
      (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.deindex-proposal id slot))))
(commit-tx)

(begin-tx "pop a LIVE proposal out of the release-loop index")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:00Z") })  ; << close-at
(env-sigs [])
(env-keys ["attacker"])
(dxns.dx.pop "P1" 1)
;; If control ever reaches here the release loop is blind and this fixture MUST fail loudly.
(expect "REGRESSION: a LIVE proposal was popped out of the active index by a stranger"
  "the module must not expose a named index writer"
  (format "prop-count {} while P1 status is {}"
    [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)
     (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "P1"))]))
(commit-tx)
