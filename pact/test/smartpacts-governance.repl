;; --- deindex: ending a proposal removes it from the active release-loop set ---
;; a later change bounded the lifecycle to the proposal's own clock, so the two transitions are
;; now exercised on the side of close-at where each is legal: cancel INSIDE the window
;; (below), close AFTER it (next tx). Both must swap-and-pop identically, since the
;; release-loop bound depends on the index shrinking either way.
(begin-tx "GOV: cancel removes proposal from the active index (bounded release-loop)")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PX" "t" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PY" "t" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200)
(let ((before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PX")
  (expect "active-proposal count decremented on cancel" (- before 1) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
;; PY (was the tail, swapped into PX's slot) is still active + votable
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:00Z") })
(env-keys ["carol-key"])
(expect "PY still votable after PX was swapped-and-popped" "vote cast"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "PY" true))
(expect-failure "PX (cancelled) not votable"
  "proposal not active" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "PX" true))
(commit-tx)

(begin-tx "GOV: close AFTER close-at deindexes the same way")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-06T00:00:00Z") })   ; PY closed 06-05
(let ((before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
  (expect "close PY once its deadline has passed" "proposal closed"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "PY"))
  (expect "active-proposal count decremented on close" (- before 1) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
(commit-tx)

;; ===========================================================================
;; CHAIN-LOCAL VOTING (the design record) — the same live-vote machinery on a NON-hub chain.
;; NOTE: the REPL tokens ONE DB, so "chain 5" here tokens tables with chain 0 —
;; this exercises the code paths (no hub enforce; vkey chain-scoping; local release;
;; local freeze), NOT per-chain isolation. Isolation + SPV are DEVNET-only.
;; ===========================================================================
(begin-tx "CL: admin announces PL on chain 5 (identical payload as everywhere)")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "5", "block-time": (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(expect "replica announced off-hub" "proposal created"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PL" "chain-local" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200))
(commit-tx)

(begin-tx "CL: dave votes PL on chain 5 with his CURRENT local tokens")
