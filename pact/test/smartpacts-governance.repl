  (expect "a finding: status untouched" "active" (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PW")))
  (expect "a finding: still indexed" count-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
(rollback-tx)

(begin-tx "a later change a finding: cancel is STILL admin-only — permissionless close did not leak")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-01T00:00:00Z") })  ; before open-at, i.e. cancel is otherwise LEGAL here
(env-sigs [{ "key": "carol-key", "caps": [] }])
(expect-failure "a non-admin cannot cancel" "Keyset failure"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PW"))
(expect "a finding: status untouched" "active" (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PW")))
(rollback-tx)


;; ===========================================================================
;; a later change SWAP INTEGRITY (cold-audit a finding) — the load-bearing line of the fix.
;;
;; The inlined swap-and-pop moves the TAIL entry into the freed slot and rewrites that
;; entry's `active-slot`. That rewrite had NO regression guard: deleting it from both
;; callers left the entire committed suite green (mutation-verified ), because the
;; only index test asserted the COUNT and "the other proposal is still votable" — and
;; cast-vote never reads prop-index, so it passes over a corrupt index. That is exactly the
;; blindness the original CRITICAL exploited, and it needs no attacker: routine admin
;; closes re-create it.
;;
;; These assert the three things that actually matter, for BOTH transitions, with a
;; NON-TAIL target so a swap really happens:
;; (a) the moved proposal's recorded active-slot equals the freed slot,
;; (b) the freed index position resolves back to that proposal,
;; (c) the RELEASE LOOP still finds it — a transfer by its voter still releases the vote.
;; (c) is the one that matters: the loop iterates prop-index, so a stale active-slot makes a
;; live proposal invisible to it and the same tokens can vote twice.
;; ===========================================================================
(begin-tx "SWAP setup: three active proposals, votes on the one that will MOVE")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-08-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "S1" "head" "d" (add-time (time "2026-08-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-08-01T00:00:00Z") 1.0) 259200)   ; close 08-04
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "S2" "mid"  "d" (add-time (time "2026-08-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-08-01T00:00:00Z") 1.0) 604800)   ; close 08-08
;; S3 must OUTLIVE S1: the point is to close S1 (moving S3 into its slot) while S3 is STILL
;; ACTIVE, so the release loop has something live to reach. Equal durations would leave S3
;; already frozen by close-at and (c) would pass vacuously.
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "S3" "tail" "d" (add-time (time "2026-08-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-08-01T00:00:00Z") 1.0) 604800)   ; close 08-08
(commit-tx)

(begin-tx "SWAP: closing the HEAD moves the TAIL into its slot — all three properties")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-08-01T01:00:00Z") })
;; carol votes on S3, the proposal that is about to be MOVED by the swap
(env-sigs [{ "key": "carol-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.VOTE "carol")] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "S3" true)
(let ((s3-yes-before (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "S3")))
      (s1-slot (at 'active-slot (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "S1")))
      (n-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
  (expect "setup: carol's vote is in S3's tally" true (> s3-yes-before 0.0))
 ;; close the HEAD (S1) at/after its deadline -> the tail (S3) must swap into S1's slot
  (env-chain-data { "chain-id": "0", "block-time": (time "2026-08-04T00:00:01Z") })  ; S1 closed, S3 live
  (env-sigs [{ "key": "carol-key", "caps": [] }])
  (expect "permissionless close of the head" "proposal closed" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "S1"))
  (expect "count decremented" (- n-before 1) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count))
 ;; (a) the MOVED proposal's recorded slot was rewritten to the freed slot
  (expect "a finding(a): the moved proposal's active-slot is the freed slot" s1-slot
    (at 'active-slot (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "S3")))
 ;; (b) the release loop finds it: a transfer by its voter STILL releases the vote.
 ;; This is the real property — the loop iterates prop-index, so a stale active-slot
 ;; would make S3 invisible and carol's tokens would stay counted while she moves them.
  (env-data { "swapee": { "keys": ["swapee-key"], "pred": "keys-all" } })
  (env-sigs [{ "key": "carol-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "carol" "swapee" 100.0)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "carol" "swapee" (read-keyset 'swapee) 100.0)
  (expect "control: the moved proposal is genuinely STILL ACTIVE (else (c) is vacuous)" true
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-active? "S3"))
  (expect "a finding(c): the release loop STILL reaches the moved proposal" (- s3-yes-before 100.0)
    (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "S3"))))
(commit-tx)


(begin-tx "SWAP: the CANCEL path performs the identical swap — same three properties")
;; Both callers carry a byte-identical copy of the inlined block, so both need the guard.
;; Testing only close would leave the cancel copy free to rot.
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-09-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })

;; the design record forces these two onto DIFFERENT schedules, and the reason is the property under
;; test. The swap-on-cancel needs a LIVE tail proposal carrying a real vote at the moment the
;; head is cancelled — but cancel is legal only before open-at and a vote is possible only
;; after it, so one proposal cannot be in both states. K1 (the head being cancelled) is
;; therefore announced with a LATER open-at than K2 (the tail that must keep its vote). Two
;; proposals on different schedules is the ordinary case, not a contrivance.
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "K1" "head" "d" (add-time (time "2026-09-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (time "2026-09-05T00:00:00Z") 259200)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "K2" "tail" "d" (add-time (time "2026-09-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-09-01T00:00:00Z") 1.0) 604800)
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-01T00:00:01Z") })  ; K2 is open
(env-sigs [{ "key": "carol-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.VOTE "carol")] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "K2" true)
(let ((k2-yes-before (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "K2")))
      (k1-slot (at 'active-slot (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "K1")))
      (n-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
  (expect "setup: carol's vote is in K2's tally" true (> k2-yes-before 0.0))
 ;; cancel the HEAD inside its window -> the tail (K2) swaps into K1's slot
  (env-chain-data { "chain-id": "0", "block-time": (time "2026-09-01T00:30:00Z") })
  (env-keys ["admin-key"])
 ;; K1 has not opened yet (open-at ), so its cancel is still legal here.
  (expect "cancel the head before it opens" "proposal cancelled" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "K1"))
  (expect "count decremented on cancel" (- n-before 1) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count))
  (expect "a finding(a) cancel: the moved proposal's active-slot is the freed slot" k1-slot
    (at 'active-slot (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "K2")))
  (expect "control: the moved proposal is genuinely STILL ACTIVE" true
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-active? "K2"))
  (env-data { "kswapee": { "keys": ["kswapee-key"], "pred": "keys-all" } })
  (env-sigs [{ "key": "carol-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "carol" "kswapee" 50.0)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "carol" "kswapee" (read-keyset 'kswapee) 50.0)
  (expect "a finding(c) cancel: the release loop STILL reaches the moved proposal" (- k2-yes-before 50.0)
    (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "K2"))))
(commit-tx)

;; ---------------------------------------------------------------------------
;; The CANCELLED-REPLICA TRAP (an internal review a finding). With `enforce-reportable` deleted
;; along with the aggregation, nothing ON-CHAIN stops an off-chain summer adding a
;; cancelled chain's frozen tally into a total. This pins the shape so the rule in
;; `vote-record`'s docstring is not quietly re-derived without its last clause.
;; ---------------------------------------------------------------------------
(begin-tx "CANCEL-TRAP: a cancelled proposal still reads exists + frozen with real votes")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-09-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal
  "CANX" "to be cancelled" "d" (add-time (time "2026-09-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-09-01T00:00:00Z") 1.0) 259200)
(commit-tx)
(begin-tx "CANCEL-TRAP: seed a holder — the earlier sections moved alice's tokens away")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-01T00:05:00Z") })
(env-data { "dave": { "keys": ["dave-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "dave" 500.0)] }])
(coin.transfer-create "sender00" "dave" (read-keyset 'dave) 500.0)
(env-sigs [{ "key": "dave-key", "caps": [(coin.TRANSFER "dave" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "dave" (read-keyset 'dave) 1000.0)
(commit-tx)
(begin-tx "CANCEL-TRAP: the vote lands only AFTER voting opens (the design record)")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-01T00:10:00Z") })
(env-sigs [{ "key": "dave-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.VOTE "dave")] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "dave" "CANX" true)
(commit-tx)

;; ---------------------------------------------------------------------------
;; 🔴 the design record NARROWED THIS TRAP, AND THE NARROWING IS THE POINT — it is recorded here
;; rather than in a report because the rule it qualifies lives in `vote-record`'s docstring.
;;
;; Cold an internal review a finding was: a CANCELLED proposal carrying 5,000 real votes reads
;; exists:true, frozen:true, status:"cancelled", yes:5000.0 — so twenty cancelled replicas
;; satisfy the four-part summing rule and an off-chain summer publishes a result the admin
;; voided. The `status != "cancelled"` clause is what stands between them and that.
;;
;; UNDER the design record A CANCELLED PROPOSAL CANNOT CARRY VOTES AT ALL. `cancel-proposal` requires
;; now < open-at and `cast-vote` requires now >= open-at, and chain time only moves forward
;; — so any proposal that was legally cancelled was cancelled before a single vote could be
;; cast, and its tally is necessarily 0.0/0.0. The measured a finding state is UNREACHABLE on
;; chain. (It is still constructible in the REPL, where the clock can be moved backwards;
;; that is a REPL affordance, not a chain behaviour, and the assertion below is written
;; against what the chain can actually produce.)
;;
;; THE STATUS CLAUSE STAYS ANYWAY, and this is deliberate rather than defensive: the
;; guarantee now rests on TIME MONOTONICITY, which is a property of consensus rather than of
;; this module, and a summer following the four-part rule without the status clause would
;; publish "0 votes, proposal passed" for twenty cancelled replicas instead of a voided
;; result. Degraded, but still wrong. Do not remove the clause on the strength of this.
;; ---------------------------------------------------------------------------
(begin-tx "CANCEL-TRAP: a cancel once voting has opened is REFUSED — the a finding state is unreachable")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-01T00:20:00Z") })
(env-keys ["admin-key"])
(expect "setup: CANX genuinely carries a real vote" true
  (> (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "CANX")) 0.0))
(expect-failure "the admin cannot cancel a proposal that already has votes"
  "SPT cannot cancel once voting has opened for this proposal"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "CANX"))
(expect "CANCEL-TRAP: status untouched by the refused cancel" "active"
  (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "CANX")))
(rollback-tx)

(begin-tx "CANCEL-TRAP: a legally cancelled proposal reads exists + frozen with a ZERO tally")
;; CANY is announced and cancelled entirely inside its review gap — the only way a cancel
;; can happen now. It is the shape a summer will actually meet.
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-09-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal
  "CANY" "cancelled in the review gap" "d"
  (add-time (time "2026-09-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP))
  (time "2026-09-06T00:00:00Z") 259200)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "CANY")
(commit-tx)

(begin-tx "CANCEL-TRAP: past close-at it satisfies every part of the rule EXCEPT the status clause")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-09-20T00:00:00Z") })
(let ((v (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "CANY")))
  (expect "CANCEL-TRAP: exists" true (at 'exists v))
  (expect "CANCEL-TRAP: frozen" true (at 'frozen v))
 ;; the design record: zeros, not real votes — a legal cancel always precedes every vote.
  (expect "CANCEL-TRAP: the tally is ZERO, because no vote could have been cast" 0.0
    (+ (at 'yes v) (at 'no v)))
 ;; …and the status clause is still the only thing telling a summer this is not a result.
  (expect "CANCEL-TRAP: status is the ONLY signal — it must be checked" "cancelled" (at 'status v)))
(commit-tx)

(print "smartpacts-governance LIVE-VOTE suite PASSED")
