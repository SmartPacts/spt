;; ===========================================================================
;; smartpacts-governance REPL suite — LIVE-VOTE governance (the design record), now merged into
;; SPT. Vote weight = current tokens; transfers release voted tokens from the
;; tally; re-vote updates in place; dust cannot suppress. Proposals + tally hub-only.
;; (Cross-chain cast-vote-xchain needs SPV -> validated on DEVNET, not here.)
;; ===========================================================================
(load "setup.repl")

;; seed alice 3000, bob 2000, carol 500 (founder reserve = 5000)
(begin-tx "activate launch for seeding")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.init 0.5)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.resume-sale)
(commit-tx)
(begin-tx "seed voters via launch (alice 2500, bob 2000, carol 200)")
(env-data { "alice": { "keys": ["alice-key"], "pred": "keys-all" }
       , "bob":   { "keys": ["bob-key"],   "pred": "keys-all" }
       , "carol": { "keys": ["carol-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "alice" 1250.0) (coin.TRANSFER "sender00" "bob" 1000.0) (coin.TRANSFER "sender00" "carol" 100.0)] }])
(coin.transfer-create "sender00" "alice" (read-keyset 'alice) 1250.0)
(coin.transfer-create "sender00" "bob"   (read-keyset 'bob)   1000.0)
(coin.transfer-create "sender00" "carol" (read-keyset 'carol) 100.0)
(env-sigs [{ "key": "alice-key", "caps": [(coin.TRANSFER "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1250.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "alice" (read-keyset 'alice) 2500.0)
(env-sigs [{ "key": "bob-key", "caps": [(coin.TRANSFER "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "bob" (read-keyset 'bob) 2000.0)
(env-sigs [{ "key": "carol-key", "caps": [(coin.TRANSFER "carol" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 100.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "carol" (read-keyset 'carol) 200.0)
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-01T00:00:00Z") })
(commit-tx)

;; --- proposal duration bounds + explicit created-at (the design record: the SAME payload is
;; replicated to every chain, so close-at is one shared timestamp) ---
(begin-tx "GOV: duration bounds + created-at validation")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(expect-failure "duration below 72h"
  "duration below 72h minimum"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PB" "t" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 100))
(expect-failure "duration above 14d"
  "duration above 14d maximum"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PB" "t" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 2000000))
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "P1" "Adopt plan" "desc" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200)
(expect-failure "duplicate id rejected"
  "Error during database operation: Value already found while in Insert mode in table n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT_proposals at key \"P1\""
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "P1" "t" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200))
(commit-tx)

;; --- LIVE vote: weight = current tokens ---
(begin-tx "GOV: alice votes yes 3000, bob votes no 2000")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:00Z") })
(env-keys ["alice-key"])
(expect "alice votes" "vote cast" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "alice" "P1" true))
(env-keys ["bob-key"])
(expect "bob votes" "vote cast" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "bob" "P1" false))
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
  (expect "yes 2500" 2500.0 (at 'yes r))
  (expect "no 2000" 2000.0 (at 'no r))
  (expect "participation 4500" 4500.0 (+ (at 'yes r) (at 'no r)))
 ;; quorum-met / passed DELETED with QUORUM (the design record Decision 2). What the contract can
 ;; still say is the only thing it ever really knew: this chain's yes and no.
  (expect "yes leads on this chain" true (> (at 'yes r) (at 'no r))))
(commit-tx)

;; --- vote-stealing + non-existent + zero-weight + excluded rejected ---
(begin-tx "GOV: rejections")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T01:00:00Z") })
(env-keys ["intruder-key"])
(expect-failure "vote-stealing blocked (guard)"
  "neither account guard nor registered vote key satisfied" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "alice" "P1" true))
(env-keys ["ghost-key"])
(expect-failure "non-existent account rejected"
  "No value found in table n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT_accounts for key: ghost" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "ghost" "P1" true))
(env-keys ["admin-key"])
;; 🔴 RENAMED BY a later change, AND THE OLD NAME IS THE LESSON. This was titled "excluded treasury
;; cannot vote (guard unacquirable)" and an internal review named it as coverage for
;; `"excluded reserve cannot vote"`. IT IS NOT, AND NEVER WAS: it asserts the VOTE GUARD's
;; message, which fires FIRST, so it stays green with the exclusion enforce DELETED — measured.
;; The comment beside it was honest ("the guard check fires first ... 'excluded' is the
;; backstop") while the TITLE claimed the backstop was under test. A title is what a reader and
;; an the reviewer go by, so the title is what was wrong. The real pin is §EXCL below.
(expect-failure "the VOTE guard alone refuses the treasury — it cannot even authenticate"
  "neither account guard nor registered vote key satisfied"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-ACCOUNT "P1" true))
(commit-tx)

;; ===========================================================================
;; §EXCL — a later change: "excluded reserve cannot vote" (token:2096). THE REAL PIN.
;;
;; 🔴 THE CHECK ABOVE STOPS AT THE FRONT DOOR. `cast-vote` opens with
;; `(with-capability (VOTE voter) …)`, and VOTE enforces the voter's own guard — for a reserve
;; that is a CAPABILITY GUARD over a module-internal cap, so ordinary transaction code cannot
;; satisfy it and every call dies there. The exclusion enforce sits four checks further in and
;; nothing in the suite had ever reached it: an internal review's sweep deleted it and 0 suites went red.
;;
;; TO PIN IT, THE VOTE GUARD MUST BE SATISFIED FIRST. `test-capability` grants
;; `TREASURY-GUARD`, which is exactly what `TREASURY-G` — the account's stored guard — is built
;; over, so `enforce-guard` passes and execution continues to the exclusion check.
;;
;; 🔴 THIS ROUTE IS ENGINE-INDEPENDENT ON PURPOSE. It uses REPL harness machinery, not the
;; a defect in an earlier engine, so it keeps working after Chainweb32 and must NOT be
;; triaged as a fork-gated probe. The ATTACKER-reachable route — a foreign module composing the
;; same weak cap, which is how an internal review measured it — is pinned separately in
;; a probe kept out of this repo, where the engine-dependent labelling belongs.
;;
;; 🔴 WHY THE BACKSTOP IS LOAD-BEARING RATHER THAN BELT-AND-BRACES: `set-vote-key`'s own
;; comment justifies tolerating a forged VOTE-KEY-SET on a reserve with "No voting effect
;; (cast-vote refuses an excluded reserve)". That sentence IS this enforce. With it deleted,
;; an internal review measured an unsigned caller casting the treasury's 55,000 SPT into a live tally.
;; ===========================================================================
(begin-tx "§EXCL the exclusion check refuses even once the VOTE guard is satisfied")
;; Own transaction: `test-capability` grants for the rest of the tx, and a granted reserve
;; guard leaking into later assertions would weaken every one of them silently.
(env-sigs [])
(test-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-GUARD))
;; CONTROL FIRST: prove the guard really is satisfied now, so the refusal below cannot be the
;; VOTE guard wearing a new test name. This is the check the two mis-titled negatives skipped.
(expect "§EXCL the treasury's own guard IS satisfied — we are past the VOTE gate" true
  (enforce-guard (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.account-guard
                   n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-ACCOUNT)))
(expect "§EXCL and the treasury holds real weight, so it is not refused for having none" true
  (> (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance
       n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-ACCOUNT) 0.0))
;; Snapshot the tally BEFORE the refusal, in a `let` — a top-level `defconst` evaluates in a
;; read-only frame and cannot read a table (measured: "Operation disallowed in read-only or
;; sys-only mode"). A literal 0.0 would also be WRONG here: this world already carries alice's
;; live vote, and an assertion wrong about the baseline proves nothing about the delta.
;; Own rollback-tx below because expect-failure LEAKS WRITES through commit-tx.
(let ((before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
 ;; 🔴 THE PIN. Authenticated, funded, and still refused — by the exclusion check, nothing else.
  (expect-failure "§EXCL: an authenticated, funded excluded reserve is STILL refused"
    "excluded reserve cannot vote"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote
      n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-ACCOUNT "P1" true))
  (expect "§EXCL the tally is unchanged by the refusal — no phantom weight entered" true
    (= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1") before)))
(rollback-tx)

;; --- RE-VOTE updates in place (alice flips to no) ---
(begin-tx "GOV: alice re-votes (flip yes->no); tally updates in place")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T02:00:00Z") })
(env-keys ["alice-key"])
(expect "alice re-votes" "vote cast" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "alice" "P1" false))
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
 ;; yes loses alice's 2500 -> 0; no gains 2500 -> 4500
  (expect "yes now 0 (alice flipped)" 0.0 (at 'yes r))
  (expect "no now 4500" 4500.0 (at 'no r))
  (expect "participation still 4500 (no double count)" 4500.0 (+ (at 'yes r) (at 'no r))))
(env-keys ["alice-key"])   ; flip alice back to yes for the transfer tests
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "alice" "P1" true)
(commit-tx)

;; ===========================================================================
;; THE INVARIANT — transfer releases the voted tokens from the tally (no double-vote).
;; State now: alice yes 2500, bob no 2000. alice sends 1000 to carol.
;; ===========================================================================
(begin-tx "GOV: alice (voted yes 2500) sends 1000 to carol -> tally releases 1000")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T03:00:00Z") })
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "carol" 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "alice" "carol" 1000.0)
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
  (expect "yes dropped by 1000 -> 1500 (alice's moved tokens released)" 1500.0 (at 'yes r)))
(expect "alice recorded vote now 1500" 1500.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-weight "alice" "0" "P1"))
(expect "carol received 1000 but has NOT voted (weight 0)" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-weight "carol" "0" "P1"))
(commit-tx)

(begin-tx "GOV: carol votes her 1200 (200 seed + 1000 received) — counted ONCE")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T04:00:00Z") })
(env-keys ["carol-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "P1" true)
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
 ;; yes = alice 1500 + carol 1200 = 2700 ; no = bob 2000
  (expect "yes 2700 (no double count from the transfer)" 2700.0 (at 'yes r))
  (expect "no 2000" 2000.0 (at 'no r))
  (expect "total votes <= circulating"
    true (<= (+ (at 'yes r) (at 'no r)) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))))
(commit-tx)

;; --- ATTACK: transfer-then-revote double-vote is CLOSED (the SA gap) ---
;; alice sends all her 1500 to a fresh account, then tries to re-vote with 0 tokens.
(begin-tx "GOV: transfer-then-revote double-vote blocked")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T05:00:00Z") })
(env-data { "dave": { "keys": ["dave-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "dave" 1500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer-create "alice" "dave" (read-keyset 'dave) 1500.0)
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
 ;; alice's full 1500 released -> yes = carol 1200 only
  (expect "yes 1200 after alice sent everything (her vote fully released)" 1200.0 (at 'yes r)))
(env-keys ["alice-key"])
(expect-failure "alice cannot vote with 0 tokens" "no voting weight"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "alice" "P1" true))
;; dave (received 1500) votes -> counted once; NO double count with alice's released vote
(env-keys ["dave-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "dave" "P1" true)
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
  (expect "yes = carol 1200 + dave 1500 = 2700 (no double-vote from the SA transfer gap)"
    2700.0 (at 'yes r))
  (expect "total votes <= circulating (final)"
    true (<= (+ (at 'yes r) (at 'no r)) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))))
(commit-tx)

;; --- DUST cannot suppress: dust to a voter leaves their vote untouched ---
(begin-tx "GOV: dust to dave does not change his vote")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T06:00:00Z") })
(env-sigs [{ "key": "bob-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "bob" "dave" 0.000000000001)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "bob" "dave" 0.000000000001)
(expect "dave's recorded vote unchanged by the dust he received" 1500.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-weight "dave" "0" "P1"))
;; bob SENT the dust (a debit) -> his own vote releases by the dust (1e-12), still ~2000
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
  (expect "no ~2000 (bob's tiny send released 1e-12)" 1999.999999999999 (at 'no r)))
(commit-tx)

;; --- deadline + close/cancel lifecycle ---
(begin-tx "GOV: vote after deadline rejected")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-06T00:00:00Z") })
(env-keys ["dave-key"])
(expect-failure "voting closed"
  "voting closed" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "dave" "P1" true))
(commit-tx)
(begin-tx "GOV: close + guards")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-06T00:00:00Z") })
(expect "close P1" "proposal closed" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "P1"))
(expect-failure "re-close rejected"
  "only active can close" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "P1"))
(commit-tx)
(begin-tx "GOV: vote on closed rejected")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-06T00:00:00Z") })
(env-keys ["dave-key"])
(expect-failure "proposal not active"
  "proposal not active" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "dave" "P1" true))
(commit-tx)

;; --- quorum NOT met: a fresh proposal with only a sub-quorum vote ---
(begin-tx "GOV: quorum not met")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PQ" "Quorum test" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200)
(commit-tx)
(begin-tx "GOV: only carol (1200) votes PQ -> below 4000 quorum")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:00Z") })
(env-keys ["carol-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "PQ" true)
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PQ")))
  (expect "participation 1200" 1200.0 (+ (at 'yes r) (at 'no r)))
 ;; There is no on-chain quorum any more (the design record Decision 2): a thin turnout is simply a
 ;; thin turnout, reported honestly, and the threshold lives in the charter.
  (expect "a thin turnout is still recorded exactly" 1200.0 (+ (at 'yes r) (at 'no r))))
(commit-tx)

;; --- cancel lifecycle ---
(begin-tx "GOV: cancel lifecycle")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PC" "Cancel test" "d" (add-time (time "2026-06-02T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-02T00:00:00Z") 1.0) 259200)
(expect "cancel active ok" "proposal cancelled" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PC"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:00Z") })
(env-keys ["carol-key"])
(expect-failure "vote on cancelled rejected"
  "proposal not active" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "PC" true))
(env-keys ["admin-key"])
(expect-failure "re-cancel non-active rejected"
  "only active can cancel" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PC"))
(commit-tx)

;; --- a finding (the reviewer): tally is FROZEN at close-at — a transfer PAST the voting deadline
;; does NOT release votes / move the tally, so get-results is final even before the admin
;; closes the proposal. Uses a fresh holder `frank` seeded here. ---
(begin-tx "F1 seed frank 300 + create PF; frank votes 300")
(env-data { "frank": { "keys": ["frank-key"], "pred": "keys-all" }
       , "sink":  { "keys": ["sink-key"],  "pred": "keys-all" } })
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-10T00:00:00Z") })
;; seed frank 300 via launch (own tx — commit so signer state is clean before create-proposal)
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "frank" 150.0)] }])
(coin.transfer-create "sender00" "frank" (read-keyset 'frank) 150.0)
(env-sigs [{ "key": "frank-key", "caps": [(coin.TRANSFER "frank" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 150.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "frank" (read-keyset 'frank) 300.0)
