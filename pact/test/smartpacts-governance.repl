(begin-tx "a later change a finding: close-proposal is PERMISSIONLESS — a non-admin can close")
;; This is the suppression-by-inaction fix. carol holds no admin authority and signs only
;; her own key; before a later change this call died on the ADMIN keyset.
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-04T00:00:01Z") })  ; == close-at
(env-sigs [{ "key": "carol-key", "caps": [] }])
(let ((count-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
  (expect "a non-admin closes the proposal" "proposal closed" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "PW"))
  (expect "a finding: the active index drained on the permissionless close" (- count-before 1)
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
(expect "a finding: status is closed" "closed" (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PW")))
;; the result reads exactly as before — permissionless close is bookkeeping only, and the
;; tally froze at close-at whether or not anyone paid for the transaction (the design record).
(expect "a finding: the record is frozen and readable after the permissionless close" true
  (at 'frozen (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "PW")))
(expect "a finding: and its status now reflects the close" "closed"
  (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "PW")))
(rollback-tx)

(begin-tx "a later change a finding: permissionless close is still bounded by close-at")
;; Removing the admin gate must NOT remove the a later change early-close bound — otherwise
;; anyone could freeze a chain's tally mid-window, which is strictly worse than an admin
;; being able to.
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-03T00:00:00Z") })  ; < close-at
(env-sigs [{ "key": "carol-key", "caps": [] }])
