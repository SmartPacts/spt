;; ===========================================================================
;; AGGREGATION (the design record) — post-close, the hub's own frozen tally is recorded into
;; the canonical aggregate, permissionlessly. (Report-path attack boundaries are in
;; spt-attacks-vgrief V8/V9; the 19 xchain reports are SPV — devnet-only.)
;; ===========================================================================
(begin-tx "RECORD: `frozen` is a close-at test, NOT a status test")
;; This is the residue the design record 3c calls out: `status` stays "active" past close-at until
;; SOMEBODY PAYS for close-proposal, so an off-chain summer keying on status either refuses
;; a final result or sums a live one. Proven here on a proposal nobody has closed.
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-06-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal
  "FRZ" "freeze probe" "status must not be the freeze test"
  (add-time (time "2026-06-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-01T00:00:00Z") 1.0) 259200)
;; before close-at: not frozen
(let ((v (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "FRZ")))
  (expect "FRZ: not frozen during the window" false (at 'frozen v))
  (expect "FRZ: status active during the window" "active" (at 'status v)))
;; past close-at, with NO close-proposal transaction anywhere
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-10T00:00:00Z") })
(let ((v (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "FRZ")))
  (expect "FRZ: FROZEN past close-at although nobody closed it" true (at 'frozen v))
  (expect "FRZ: and status is STILL active — the two are independent" "active" (at 'status v)))
(commit-tx)

(begin-tx "RECORD: vote-record is the product — self-describing, and frozen at close-at")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-07T00:00:00Z") })
(env-keys ["carol-key"])   ; anyone may read; no privileged access
;; This replaces the deleted "permissionless hub report" block. The claim is no longer
;; "the aggregate copied the frozen tally" — there is no aggregate. It is "one read tells
;; an the reviewer everything needed to sum this chain and prove the replica matches".
(let ((v (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "P1"))
      (r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "P1")))
  (expect "RECORD: the replica exists here" true (at 'exists v))
  (expect "RECORD: yes matches the tally read" (at 'yes r) (at 'yes v))
  (expect "RECORD: no matches the tally read"  (at 'no r)  (at 'no v))
  (expect "RECORD: this chain is named in the row" "0" (at 'chain v))
  (expect "RECORD: FROZEN past close-at, regardless of whether anyone paid to close"
    true (at 'frozen v))
  (expect "RECORD: the digest is non-empty and stable"
    (at 'digest v) (at 'digest (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "P1"))))
;; A MISSING replica must return a sentinel, not abort — this is what lets an the reviewer tell
;; "chain 7 never got the proposal" from "chain 7 is unreachable". It aborted before the design record.
(let ((m (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "NEVER-ANNOUNCED")))
  (expect "RECORD: a missing replica reports exists:false" false (at 'exists m))
  (expect "RECORD: a missing replica has an empty digest" "" (at 'digest m))
  (expect "RECORD: a missing replica is not frozen" false (at 'frozen m))
  (expect "RECORD: and carries no votes" 0.0 (+ (at 'yes m) (at 'no m))))
;; CONTROL: the digest must actually discriminate, or the 20-chain equality check is theatre.
;; 🔴 THIS CONTROL WAS ITSELF THEATRE UNTIL (survived both skeptics). It
;; compared P1 against "P2" — an id NEVER CREATED, in this suite or setup.repl. `vote-record`
;; is total by design and returns the missing-replica sentinel `""` for an unknown id, so the
;; comparison was `<real digest> != ""`, which holds on ANY module, including one whose digest
;; is a hard-coded constant. The control that exists to prove discrimination proved nothing.
;; It now compares two proposals that BOTH EXIST and differ only in their content.
(expect "RECORD: both proposals in this control actually exist" true
  (and (at 'exists (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "P1"))
       (at 'exists (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "PQ"))))
(expect "RECORD: a different proposal has a different digest" false
  (= (at 'digest (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "P1"))
     (at 'digest (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "PQ"))))
;; And the sentinel is still the sentinel — asserted separately rather than conflated with
;; discrimination, which is exactly how the two got mixed up in the first place.
(expect "RECORD: an unknown id returns the empty-digest sentinel, not a real digest" ""
  (at 'digest (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "P2")))
(commit-tx)

;; ===========================================================================
;; a later change — THE PROPOSAL LIFECYCLE IS BOUNDED BY close-at, BOTH DIRECTIONS.
;; ---------------------------------------------------------------------------
;; Pre-fix, `status` stayed "active" until an admin close tx landed, so BOTH admin
;; transitions could cross the deadline and both corrupted the canonical result:
;; * cancel AFTER close-at -> the frozen result was already public, and cancelling
;; made enforce-reportable reject every report forever (measured: yes 4500 / no 0
;; closed, cancelled, get-final-results pinned at 0/0).
;; * close BEFORE close-at -> froze THIS chain's tally early, disenfranchising every
;; remaining holder mid-window, while the truncated tally still reported into the
;; canonical aggregate as legitimate (measured: closed 2 days early with yes 2500).
;; Each negative asserts the STATE IS UNCHANGED, not merely that an error was raised —
;; the claim is that the outcome survives the attempt, not that a string came back.
;; ===========================================================================
(begin-tx "a later change setup: PZ carries a real, quorum-passing result")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-06-20T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal
  "PZ" "Lifecycle" "d" (add-time (time "2026-06-20T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-06-20T00:00:00Z") 1.0) 259200)   ; open-at 2026-06-20T00:00:01, close-at 2026-06-23T00:00:01
;; the design record: announce and vote are in one tx here, so the clock must cross open-at between them.
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-20T00:00:01Z") })
(env-keys ["bob-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "bob" "PZ" true)
(commit-tx)

(begin-tx "a later change N-1: close BEFORE close-at is rejected, and voting stays open")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-21T00:00:00Z") })  ; < close-at
(env-keys ["admin-key"])
(expect-failure "early close rejected" "cannot close before voting has ended"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "PZ"))
(expect "N-1: status untouched by the rejected close" "active"
  (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PZ")))
;; The real damage was disenfranchisement, so assert the franchise itself survived.
(env-keys ["carol-key"])
(expect "N-1: a holder can still vote — the window was NOT truncated" "vote cast"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "carol" "PZ" false))
(rollback-tx)

(begin-tx "a later change N-2: cancel AFTER close-at is rejected, and the result still reports")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-24T00:00:00Z") })  ; > close-at
(env-keys ["admin-key"])
(expect-failure "late cancel rejected" "cannot cancel after voting has closed"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PZ"))
(expect "N-2: status untouched by the rejected cancel" "active"
  (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PZ")))
;; The whole point of the fix: the OUTCOME SURVIVES the late cancel attempt. With the
;; aggregate deleted (the design record), "survives" means the record still reads correctly and frozen.
(env-keys ["carol-key"])   ; anyone may read
(let ((r (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PZ"))
      (v (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.vote-record "PZ")))
  (expect "N-2: the record still carries the real tally, not a voided one" (at 'yes r) (at 'yes v))
  (expect "N-2: and it is frozen, so an reviewer may sum it" true (at 'frozen v))
  (expect "N-2: status was NOT flipped to cancelled" "active" (at 'status v)))
(rollback-tx)

;; --- POSITIVE CONTROLS: each transition still works on its own side of close-at.
;; Without these the two negatives above would also pass if cancel/close were simply
;; broken for every input, which is the failure mode a bound like this invites.
(begin-tx "a later change N-3 CONTROL: cancel BEFORE open-at still works")
;; Moved twice now, and for the same reason both times: a control has to sit where the
;; transition is legal, or it fails for the NEW reason and stops controlling anything.
;; a later change moved it inside CANCEL-WINDOW; the design record moves it before open-at
;; (PZ: created-at, open-at T00:00:01, close-at T00:00:01).
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-20T00:00:00Z") })
(env-keys ["admin-key"])
(expect "cancel is legal inside the window" "proposal cancelled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PZ"))
(rollback-tx)

(begin-tx "a later change N-4 CONTROL: close AFTER the window still works")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-24T00:00:00Z") })
(env-keys ["admin-key"])
(expect "close is legal at/after close-at" "proposal closed"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "PZ"))
(rollback-tx)

;; --- the boundary itself: close-at is INCLUSIVE for close, and cancel is already shut, so
;; exactly one transition is legal at every instant and there is no gap or overlap.
;; the design record NOTE, corrected after measuring rather than reasoning. The close-at bound on
;; cancel is now LOGICALLY REDUNDANT — open-at is strictly before close-at (duration >=
;; MIN-PROPOSAL-DURATION > 0), so anything the close-at bound rejects the open-at bound
;; would reject too — but it is NOT unreachable: it is written FIRST in cancel-proposal, so
;; at/after close-at it is the one that fires, and deleting it would change this message.
;; Both bounds therefore keep their own falsifying negative, and this is the close-at one.
(begin-tx "a later change N-5: at exactly close-at, close is legal and cancel is not")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-23T00:00:01Z") })  ; == close-at
(env-keys ["admin-key"])
(expect-failure "cancel at the instant of close-at is rejected" "cannot cancel after voting has closed"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PZ"))
(expect "close at the instant of close-at is accepted" "proposal closed"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.close-proposal "PZ"))
(rollback-tx)


;; ===========================================================================
;; a later change + the design record — THE VETO IS CLOSED AT BOTH ENDS (the operator runbook §2.7).
;; A1: close-proposal is PERMISSIONLESS (removes suppression-by-inaction).
;; A2: cancel-proposal is bounded to BEFORE `open-at` (the design record, replacing a later change's
;; 1-hour CANCEL-WINDOW). Identical on all 20 chains because open-at is replicated
;; AND is in the vote-record digest, so a replica carrying a different one fails the
;; 20-chain check rather than diverging silently.
;;
;; 🔴 WHY THE BOUND MOVED, because the old one still reads as reasonable: 1 hour was not
;; chosen for review time, it was chosen to keep the admin BLIND, and it bought blindness
;; by being too short to be useful. the design record gets blindness for free instead — cast-vote
;; refuses before open-at, so while cancel is legal THERE IS NOTHING TO READ. The
;; ordering below reflects that: the cancel bound is exercised BEFORE any vote exists,
;; because under this design no vote CAN exist while cancel is legal. That is the
;; property, not an artifact of the test.
;; Every negative asserts STATE UNCHANGED, and each has a positive control on the other
;; side of the bound — a bound that rejected everything would otherwise pass its negative.
;; ===========================================================================
(begin-tx "a later change setup: PW is ANNOUNCED (created-at 06-29, open-at 07-01T00:00:01)")
(env-keys ["admin-key"])
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-07-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) })
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.create-proposal "PW" "Veto" "d" (add-time (time "2026-07-01T00:00:00Z") (* -1.0 n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.MIN-REVIEW-GAP)) (add-time (time "2026-07-01T00:00:00Z") 1.0) 259200)  ; close-at 2026-07-04T00:00:01
;; the design record: no vote is cast yet, and none CAN be — this is the review gap. a finding/a finding below
;; exercise the cancel bound from inside it, which is the only place it is legal.
(expect "the tally is empty while cancel is still legal — blind BY CONSTRUCTION" 0.0
  (+ (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PW")) (at 'no (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PW"))))
(commit-tx)

(begin-tx "a later change a finding: and voting is REFUSED during the cancel window")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-01T00:00:00Z") })
(env-keys ["bob-key"])
;; This is the enforce that makes the cancel bound blind. Without it the admin could read a
;; tally accumulated during the review gap and then cancel — the exact veto the design record closes.
(expect-failure "no vote can be cast before open-at" "SPT voting has not opened for this proposal yet"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "bob" "PW" true))
(expect "a finding: the tally is still empty" 0.0
  (+ (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PW")) (at 'no (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PW"))))
(rollback-tx)

(begin-tx "a later change setup: PW carries a real vote, cast AFTER voting opens")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-01T01:00:00Z") })
(env-keys ["bob-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cast-vote "bob" "PW" true)
