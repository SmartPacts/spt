(begin-tx "a later change a finding CONTROL: cancel at the last legal instant IS accepted")
;; the boundary is EXCLUSIVE: `open-at` itself is already too late, one second earlier is
;; fine. Without this control a finding would also pass if cancel were simply broken.
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-01T00:00:00Z") })  ; open-at - 1s
(env-keys ["admin-key"])
(expect "cancel one second inside the window is accepted" "proposal cancelled"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PW"))
(rollback-tx)

(begin-tx "a later change a finding: at exactly open-at, cancel is already rejected")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-01T00:00:01Z") })  ; == open-at
(env-keys ["admin-key"])
(expect-failure "the window bound is exclusive" "SPT cannot cancel once voting has opened for this proposal"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PW"))
(expect "a finding: status untouched at the boundary" "active" (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PW")))
