(begin-tx "a later change a finding: cancel AFTER the window is rejected; state untouched")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-07-01T01:00:01Z") })  ; well past open-at
(env-keys ["admin-key"])
(let ((yes-before (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PW")))
      (count-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
  (expect-failure "cancel once voting has opened is rejected" "SPT cannot cancel once voting has opened for this proposal"
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.cancel-proposal "PW"))
  (expect "a finding: status untouched" "active" (at 'status (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.proposal-details "PW")))
  (expect "a finding: tally untouched" yes-before (at 'yes (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-results "PW")))
  (expect "a finding: still in the active index" count-before (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count)))
;; and the franchise survives — a holder can still vote after the rejected cancel
