;; Its own transaction, and that is the house rule rather than a workaround: a @managed
;; TRANSFER is installed once per transaction and metered, so a second transfer in the same tx
;; re-enters an already-consumed grant. One value-moving operation per transaction is also how
;; these calls actually arrive on chain.
(begin-tx "2 tokens transfer works frozen")
(env-sigs [{ "key": "alice-key", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TRANSFER "alice" "bob" 100.0)] }])
(expect "transfer works frozen" "transfer ok"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.transfer "alice" "bob" 100.0))
(expect "the credit landed" 600.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "bob"))
(expect "supply conserved across the frozen transfers" 4000.0
  (+ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "alice") (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "bob")))
(commit-tx)

