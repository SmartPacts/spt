;; ===========================================================================
;; smartpacts-frozen-invariant — THE FREEZE INVARIANT, PER MODULE, PER FUNCTION.
;; a later change. Founder definition, :
;;
;; "Freeze should only mean that the module is no longer upgradable, that's it. All
;; functionalities and operations should work as always."
;;
;; FORMALLY: for every module, and every function that is not the upgrade path, behaviour
;; with FROZEN-MODULE=true must be IDENTICAL to behaviour with FROZEN-MODULE=false. Only
;; redeploy may be refused. An operation that stops working at freeze is a DEFECT — and a
;; permanent, unfixable one, because a frozen module cannot be upgraded to repair it.
;;
;; WHY THIS FILE EXISTS. Cold an internal review a finding: `a separate gas-sponsorship module.init` composed
;; GOVERNANCE, whose body enforces `(not FROZEN-MODULE)`, so a frozen station could never be
;; created on a new chain. NO TEST COULD HAVE CAUGHT IT — two of the three modules had ZERO
;; frozen-state coverage. This is "cover the set, not the instance" applied to the invariant
;; that matters most.
;;
;; 🔴 THE METHOD IS ENUMERATION, NOT RECALL. Every public `defun`/`defpact` of both modules is
;; listed below and given one of exactly two dispositions:
;; EXERCISED — called against the FROZEN module, result asserted
;; NOT-RUNNABLE — cannot run in THIS scenario, with the reason stated
;; An unenumerated function is an untested one. The lists are transcribed from
;; `grep -nE '^\s*\(def(un|pact) '` over each module, and §0 asserts the counts so that a
;; function added later without a disposition makes this suite go RED rather than silently
;; dropping out of the set.
;;
;; SCOPE (a later amendment): `SPT` and `SPT-launch`. The gas station is NOT in
;; the first deployment and is deliberately out of scope — it gets this treatment before IT
;; ships. Its absence here is a scope decision, not coverage.
;; ===========================================================================
(load "setup.repl")

;; ---------------------------------------------------------------------------
;; SEED — build real state BEFORE freezing, because most operations need it. Everything
;; below this line runs against modules compiled with FROZEN-MODULE=true.
;; ---------------------------------------------------------------------------
(begin-tx "seed: activate the launch and create two holders")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.init 0.5)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.resume-sale)
(env-data { "alice": { "keys": ["alice-key"], "pred": "keys-all" }
       , "bob":   { "keys": ["bob-key"],   "pred": "keys-all" }
       , "carol": { "keys": ["carol-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "alice" 2000.0) (coin.TRANSFER "sender00" "bob" 1000.0)] }])
(coin.transfer-create "sender00" "alice" (read-keyset 'alice) 2000.0)
(coin.transfer-create "sender00" "bob"   (read-keyset 'bob)   1000.0)
(env-sigs [{ "key": "alice-key", "caps": [(coin.TRANSFER "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 2000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "alice" (read-keyset 'alice) 4000.0)
(commit-tx)

(begin-tx "seed: funding + a funded pool, so the award path has cash")
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT 900.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" 900.0)
(commit-tx)
(begin-tx "seed: fund the pool (the design record — before any declaration)")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards 500.0)
(commit-tx)

;; ===========================================================================
;; §0 — THE SET. Assert the function counts BEFORE freezing. If someone adds a public
;; function and does not give it a disposition below, these counts move and this suite goes
;; RED — which is the only mechanism that keeps an enumeration honest over time.
;; Counted with: grep -cE '^\s*\(defun ' / '^\s*\(defpact ' over each module.
;; ===========================================================================
(begin-tx "0 the enumerated set is complete")
;; 🔴 a later change: 76/14 -> 96/16. These were STALE by 22 functions and understated this suite's own
;; scope; the MECHANICAL half in run-tests.sh was current throughout, so coverage was never
;; short — only the number this file states about itself. Fix the number, not the coverage.
(env-data { "tokens-defuns": 96, "tokens-defpacts": 1, "launch-defuns": 16, "launch-defpacts": 0 })
;; These are transcribed counts, asserted against themselves — the REPL cannot grep the
;; source. run-tests.sh carries the MECHANICAL half: it re-greps the modules and fails if the
;; real counts move away from these numbers. Neither half is sufficient alone; the shell check
;; is what makes this one non-vacuous.
(expect "SPT public defuns enumerated below" 96 (read-msg 'tokens-defuns))
(expect "SPT defpacts enumerated below" 1 (read-msg 'tokens-defpacts))
(expect "SPT-launch public defuns enumerated below" 16 (read-msg 'launch-defuns))
(expect "SPT-launch defpacts enumerated below" 0 (read-msg 'launch-defpacts))
(commit-tx)

;; ===========================================================================
;; §1 — FREEZE BOTH MODULES IN PLACE (upgrade:true, so no create-table re-runs).
;; ===========================================================================
(begin-tx "1 freeze SPT")
(env-data
  { "ns": "n_48867b242317a0216a67f8c7ca26696b5878e0e3"
, "upgrade": true
, "spt-gov-name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.spt-gov"
, "spt-gov": { "keys": ["admin-key"], "pred": "keys-all" }
, "spt-ops-name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.spt-ops"
, "spt-ops": { "keys": ["admin-key"], "pred": "keys-any" } })
(env-keys ["admin-key"])
(load "fixtures/frozen-SPT.pact")
(commit-tx)

;; ===========================================================================
;; 🔴 §1a — THE OUTAGE WINDOW. a later change / an internal review `L4-03`, `L4-01`.
;;
;; THIS FILE USED TO STEP STRAIGHT FROM THE TX ABOVE TO THE ONE BELOW, and that single
;; adjacency was the defect: loading the frozen SALE re-links it against the newly-frozen
;; token hash, so by the time any assertion ran, service had already been restored. The suite
;; then printed "every enumerated function survives the freeze" — a banner an operator or the
;; founder reads as clearance — while stepping over an outage a later change had measured on a node.
;; The one artifact that exists to prove the freeze is safe asserted the opposite of the truth.
;;
;; MEASURED HERE, in this window (a later change): freezing `SPT` changes its module
;; hash, and `SPT-launch` is linked against the OLD one, so EVERY purchase aborts with
;; "hash not blessed". On a real chain nothing re-links the sale automatically — that is a
;; separate admin deploy — so this window is not one transaction wide, it lasts until someone
;; notices and redeploys the sale.
;;
;; 🔴 THE ORDER IS LOAD-BEARING AND THIS IS WHY (`L4-02`): the rescue below is a re-deploy of
;; SPT-launch. Freeze the SALE first and that re-deploy becomes impossible — buy and
;; launch.init are then dead FOREVER on every chain, with no admin key, no signature set and no
;; upgrade that can help, stranding the unsold launch reserve. Freeze the TOKEN first, always.
;;
;; The `bless` alternative (bless the pre-freeze hash inside the frozen token so the sale never
;; needs re-linking) removes the window entirely, and it is MEASURED ON A NODE (a later change,
;;, mined on the 3.2 devnet): bless-drill.ts D1 = an UNBLESSED hub upgrade kills
;; launch.buy with "hash not blessed"; D2 = the same upgrade carrying (bless <v1-hash>)
;; keeps buy working with NO launch redeploy. Same run, N2/P2: a decoy bless is refused
;; for in-flight cross-chain resumes (YieldProvenanceDoesNotMatch) and the real bless lets
;; them complete — so the ONE (bless <pre-freeze-hash>) line in the freeze source carries
;; BOTH rescues. the operator runbook records the result; the operator runbook remains gated on the rest of the operator runbook.
;;
;; Rolled back: this is a negative asserting state, and the standing rule is that expect-failure
;; leaks writes through commit-tx.
;; ===========================================================================
;; 🔴 L4-01 IS INVERTED BY a later change, AND THE INVERSION IS THE POINT.
;;
;; This block asserted the outage as EXPECTED BEHAVIOUR — "buy is DEAD while the sale is linked
;; to the pre-freeze token hash" — and passed. Under the founder's rule, stated three times and
;; now load-bearing ("freeze should only make the module no longer upgradable; ALL DEFUNS AND
;; DEFPACTS MUST WORK AS ALWAYS"), a dead `buy` is a DEFECT, not an expectation. So the suite was
;; PINNING THE VIOLATION: the one artifact that exists to prove a freeze is safe asserted that
;; the freeze breaks a public function, and reported [PASS] for it.
;;
;; The requirement is now the BLESSED path, and the outage is demoted to its NEGATIVE CONTROL —
;; kept, because it is the only thing that proves the bless line is what does the work, and
;; because deleting it would leave "buy survives" compatible with buy never having been at risk.
;; ===========================================================================
(begin-tx "1a NEGATIVE CONTROL: an UNBLESSED freeze kills buy — this is the defect, not the spec")
(env-data { "bob": { "keys": ["bob-key"], "pred": "keys-all" } })
(env-sigs [{ "key": "bob-key", "caps": [(coin.TRANSFER "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 500.0)] }])
;; The HASH is deliberately not pinned — it changes with every edit to the module. The module
;; NAME is, so this cannot be satisfied by coin or by the sale failing for its own reasons.
;; 🔴 THE TRAILING COLON IS LOAD-BEARING (a finding, delta an internal review). `expect-failure` matches by
;; SUBSTRING, and since the rename `SPT` is a strict PREFIX of `SPT-launch` — so without the
;; colon this pin is satisfied by `...module <ns>.SPT-launch: <hash>`, i.e. by exactly the
;; "sale failing for its own reasons" the line above claims it excludes. MEASURED, the real
;; message is `Execution aborted, hash not blessed for module <ns>.SPT: cg8sInne-…`; the colon
;; terminates the module name without pinning the volatile hash.
(expect-failure "L4-01a CONTROL: an UNBLESSED freeze DOES kill buy — the harm is real"
  "hash not blessed for module n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT:"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "bob" (read-keyset 'bob) 10.0))
(rollback-tx)

;; ...and the tx below IS the rescue: re-deploying the sale re-links it to the frozen token.
;; That is the runbook step L4-02 says must never be made impossible by freezing the sale first.
(begin-tx "1 freeze SPT-launch")
(env-data
  { "ns": "n_48867b242317a0216a67f8c7ca26696b5878e0e3"
, "upgrade": true
, "spt-gov-name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.spt-gov"
, "spt-gov": { "keys": ["admin-key"], "pred": "keys-all" }
, "spt-ops-name": "n_48867b242317a0216a67f8c7ca26696b5878e0e3.spt-ops"
, "spt-ops": { "keys": ["admin-key"], "pred": "keys-any" } })
(env-keys ["admin-key"])
(load "fixtures/frozen-SPT-launch.pact")
(commit-tx)

;; 🔴 POSITIVE CONTROL ON THE FIXTURES THEMSELVES. Without this every assertion in this file
;; would pass just as well against UNFROZEN modules, and the suite would report a
;; freeze-survival property it never tested. This is the check that makes the rest mean
;; anything, and it is why the generator's own "did not flip FROZEN-MODULE" guard is not
;; enough on its own: that guard runs in the shell, this one runs against what actually loaded.
(begin-tx "1 CONTROL: both loaded modules really are frozen")
(expect "SPT is FROZEN" true
  n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FROZEN-MODULE)
(expect "SPT-launch is FROZEN" true
  n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.FROZEN-MODULE)
(commit-tx)

;; ===========================================================================
;; §2 — SPT: EVERY PUBLIC FUNCTION, FROZEN.
;;
;; NOT-RUNNABLE in this scenario, with reasons (each is a state precondition, never a freeze
;; effect — that distinction is the whole point of listing them rather than omitting them):
;; init-supply one-shot, already ran in setup.repl on chain 0 (§5 proves it
;; still REACHES its own guard when frozen, i.e. it is not the
;; freeze that stops it)
;; init chain-0 guard: this scenario is chain 0, so `init` refuses by
;; design ("Use init-supply on chain 0"); §5 proves that refusal
;; is the chain check and not the freeze
;; transfer-crosschain 🔴 CORRECTED a later change. This said "step 1 needs SPV — DEVNET ONLY,
;; never runnable in the REPL", and that was FALSE. `continue-pact 1`
;; runs it, measured. The disposition hid a CRITICAL for months: an
;; UNBLESSED freeze aborts step 1 with "Yield provenance does not
;; match", DESTROYING an in-flight transfer whose sender was already
;; debited at step 0. Step 1 is now exercised across a blessed freeze
;; in smartpacts-freeze-blessed.repl B-2/B-3, and the unblessed case
;; is its mutation. FOURTH "node-only" claim disproved this week —
;; treat every remaining one as unverified until it is run.
;; funding-guard/pool-guard defconst-bound at load; exercised implicitly, since every
;; FUNDING/POOL spend below depends on the guard they built
;; TRANSFER-mgr the @managed manager, exercised by every transfer below (it
;; meters each one); TRANSFER_XCHAIN-mgr likewise, by step 0
;; TRANSFER_XCHAIN-mgr as above — and note this one is why the count is 73, not 72:
;; my first transcription truncated its name at the underscore and
;; silently dropped it. The shell count in run-tests.sh caught it,
;; which is exactly why the enumeration has a mechanical half.
;; DISBURSE-mgr a later change. The @managed manager for DISBURSE, exercised by the
;; frozen disbursement in §2 — which now spends an approved budget
;; and then proves the SAME frozen module refuses a second call
;; ("DISBURSE exceeded: 10.0 requested of 0.0 managed"). Like the
;; two above it is never called directly and carries no guard of
;; its own: the engine invokes it on each acquisition and its
;; authority is the defcap's. 🔴 ITS FREEZE PROPERTY IS NOT "it
;; still runs" BUT "the LIMIT still binds" — a meter that quietly
;; stopped metering after the freeze would be unfixable, so the
;; enumeration entry and the §2 negative are one disposition, not
;; two. Written BEFORE the count moved 95 -> 96.
;; enforce-treasury-beneficiary / enforce-launch-reserve / enforce-beneficiary /
;; enforce-not-initialized init-time validators, reached only through init/init-supply
;; results-of / vkey / pkey / rkey pure helpers, exercised via their callers
;; ===========================================================================

(begin-tx "2 tokens READS all answer frozen")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-02T00:00:00Z") })
;; The freeze transactions replaced env-data wholesale, so the keysets this section compares
;; against have to be put back. (setup.repl:46 does the same thing and a later change found the
;; identical trap: a dropped keyset made a whole assertion block abort BEFORE the function it
;; named, while a 2-arg expect-failure reported it as a pass.)
(env-data { "alice": { "keys": ["alice-key"], "pred": "keys-all" }
       , "bob":   { "keys": ["bob-key"],   "pred": "keys-all" }
       , "carol": { "keys": ["carol-key"], "pred": "keys-all" }
       , "frozen-probe-ks": { "keys": ["9999999999999999999999999999999999999999999999999999999999999999"], "pred": "keys-all" } })
(expect "get-balance" 4000.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "alice"))
(expect "details" "alice" (at 'account (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.details "alice")))
(expect "get-guard" (read-keyset 'alice) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-guard "alice"))
(expect "precision" 12 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.precision))
(expect "enforce-unit" true (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.enforce-unit 1.0))
(expect "get-circulating" 4000.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(expect "get-rpt" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "max-rpt" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.max-rpt))
(expect "outstanding-rate" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.outstanding-rate))
(expect "award-liability" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
(expect "declared-liability" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability))
(expect "pool-surplus" 500.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pool-surplus))
(expect "get-round-count" 0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round-count))
;; --- get-round (added a later change / an internal review a finding) — EXERCISED FROZEN -------------
;; 🔴 THIS FUNCTION EXISTS BECAUSE ITS ABSENCE WAS A FREEZE DEFECT, so "does it work frozen"
;; is not a formality here — it is the entire point. Before it, `{rate, effective-at}` at an
;; index was reachable only through module admin, and GOVERNANCE enforces (not FROZEN-MODULE)
;; BEFORE the keyset check, so after the freeze the operator runbook's MANDATORY --verify-rounds step could
;; never run again on any key. This module is FROZEN; the call below is the proof it survives.
;;
;; Both branches are exercised, but NOT both here: the exists:FALSE branch is below (it is the
;; one a 20-chain comparator hits on a chain that never received a declaration — precisely the
;; divergence the step exists to detect), and the exists:TRUE branch is asserted in §2's
;; declare-round block, which is the only point in this suite where a round exists.
;; 🔴 THIS COMMENT USED TO SAY "BOTH BRANCHES are exercised, deliberately" WHILE ALL THREE
;; get-round ASSERTIONS BELOW HIT exists:false. The `with-read` — the only path that can abort
;; and the whole reason the function exists — was covered by nothing, while the enumeration
;; gate and the MANDATORY-step gate both passed on it. A false coverage claim in frozen text.
(expect "get-rounds-applied: exported so ops never needs module admin, frozen"
  0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rounds-applied))
(expect "get-round: a never-declared index reports exists:false, frozen"
  { "index": 1, "exists": false, "rate": 0.0
, "effective-at": (time "1970-01-01T00:00:00Z") }
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round 1))
(expect "get-round: index 0 and negatives are out of range, not an abort"
  false
  (at 'exists (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-round 0)))
(expect "get-prop-count" 0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-prop-count))
(expect "active-prop-indices" [] (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.active-prop-indices))
(expect "get-launch-reserve" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.LAUNCH-RESERVE-ACCOUNT
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-launch-reserve))
;; `get-treasury-beneficiary` is DELETED (a later amendment / a later change) with the field it read —
;; the treasury tranche is module-held now, so there is no configured beneficiary anywhere.
;; --- ensure-coin-account (added a later change / a finding) — EXERCISED FROZEN -----------
;; It creates a coin row only if one does not already exist. Both branches are
;; exercised here against the FROZEN module, because the whole reason it exists
;; is that the missing branch permanently bricked init on a chain, and freeze is
;; exactly when "permanently" stops being recoverable. It acquires no capability
;; and touches no module table, so nothing in it can die at freeze.
(expect "ensure-coin-account is a NO-OP when the row already exists (frozen)"
  "coin account already exists"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.ensure-coin-account
    n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT
    n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-G))
(expect "ensure-coin-account CREATES a missing row (frozen)"
  "Write succeeded"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.ensure-coin-account
    "k:9999999999999999999999999999999999999999999999999999999999999999"
    (read-keyset 'frozen-probe-ks)))

(expect "protocol-account? true for a reserve" true
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.protocol-account? n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-ACCOUNT))
(expect "protocol-account? false for a holder" false
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.protocol-account? "alice"))
(expect "excluded? true for a reserve" true
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.excluded? n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.TREASURY-ACCOUNT))
(expect "excluded? false for a holder" false (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.excluded? "alice"))
(expect "validate-account" true (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.validate-account "alice"))
(expect "enforce-reserved (non-principal)" true
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.enforce-reserved "alice" (read-keyset 'alice)))
(expect "pending-awards-of" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "alice"))
(expect "curr-time" (time "2026-06-02T00:00:00Z") (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.curr-time))
(expect "this-chain" "0" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.this-chain))
(expect "account-guard" (read-keyset 'alice) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.account-guard "alice"))
(expect "tranche-vested (pre-cliff)" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.tranche-vested 100.0 (time "2027-01-01T00:00:00Z") (time "2028-01-01T00:00:00Z") (time "2026-06-02T00:00:00Z")))
(expect "get-tranche" 15000.0 (at 'total (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-tranche "liquidity")))
(expect "tranche-releasable" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.tranche-releasable "liquidity"))
;; a later amendment (a later change): the founder-requested availability reader, EXERCISED FROZEN.
(expect "tranche-available" 0.0 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.tranche-available "liquidity"))
(expect-failure "tranche-available refuses a founder allocation frozen (category error)"
  "SPT only the treasury and liquidity tranches have a disbursable balance"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.tranche-available
    "founder:k:f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0"))
(expect "credit-plan is pure and answers" 4000.0
  (let ((_ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.credit-plan "alice" (read-keyset 'alice) 1.0)))
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-balance "alice")))
(commit-tx)

(begin-tx "2 tokens create-account + rotate, frozen")
