;; ===========================================================================
;; smartpacts-snapshot-open — THE `min` INSIDE `snap-open` WAS NEVER PERTURBED.
;; ---------------------------------------------------------------------------
;; WHAT THIS FILE IS FOR. Mutation testing of the award arithmetic (a later change) found that
;; `snap-open`'s cap choice — SPT.pact, the line
;;
;; (* (- (if (< rpt-at cap) rpt-at cap) base) (- gcirc circ))
;;
;; was REACHED by roughly a thousand assertions and PINNED by none. Two mutants survived the
;; whole suite green:
;;
;; M-A (if (< rpt-at cap) rpt-at cap) -> cap ; collapse the min to its HIGH branch
;; M-B (if (< rpt-at cap) rpt-at cap) -> (if (> rpt-at cap) rpt-at cap) ; min becomes MAX
;;
;; i.e. NOTHING IN THIS REPO COULD TELL A MIN FROM A MAX on the number that prices every
;; holder's record-date correction. Both mutants are identical to the original everywhere the
;; old suite went, because of one fact about the SCENARIOS rather than the code: the suite only
;; ever evaluated this line when the float delta `(- gcirc circ)` was exactly 0, or when
;; `rpt-at` had already reached `cap`. A zero multiplier and a tie both hide the branch. That is
;; the same structurally-zero-term defect the P-5 block of smartpacts-record-date.repl was written to
;; fix, recurring ONE LEVEL UP in the very same function.
;;
;; THE ONE STATE THAT SEPARATES THEM, and it is the ordinary operating state of a live round:
;; * a generation is SEALED and still UNSETTLED,
;; * the chain's float has MOVED since that record instant (new tokens sold, so gcirc != circ),
;; * a round is DECLARED against that generation but is NOT YET EFFECTIVE, so rpt-at < cap.
;; That is the declaration window — every round on all 20 chains sits in it for at least the
;; full runway, by construction, because `declare-round` refuses a shorter lead.
;;
;; In that window the correct answer is that the record-date correction has NOT yet moved:
;; `min(rpt-at, cap) - base` is `rpt-at - base` = 0, so `snap-open` is 0.0 no matter how far the
;; float has drifted. Both mutants instead price the correction at the FULL round rate before the
;; round exists in law, and `award-liability` is wrong by `rate x (gcirc - circ)`.
;;
;; 🔴 THIS IS NOT ONLY A REPORTING NUMBER. `fund-awards` reads `award-liability` and ENFORCES
;; `pool + deposit >= floor(liability)`. Understating it lets an operator "successfully" fund a
;; chain that cannot pay; overstating it (float shrinks instead of grows) refuses a funding that
;; is legitimate. Both are admin-reachable during every declaration window, and this module
;; FREEZES.
;;
;; WHAT IS PINNED HERE, and why it is enough to kill both mutants:
;; S-4 in the declaration window, with a PROVEN non-zero float delta and a PROVEN live low
;; branch (rpt-at strictly below cap), `snap-open` is exactly 0.0 and `award-liability`
;; equals the naive per-holder sum. M-A and M-B both read -40.0 here instead of 0.0.
;; S-5 the two module guards that make `rpt-at > cap` UNREACHABLE, so that S-4's window is
;; the ONLY place the branch is observable. If either guard is ever deleted, the
;; reasoning above stops being true and these two negatives go red first.
;; S-6 the positive control that stops S-4 passing vacuously: once the round IS effective the
;; same call reads exactly rate x (gcirc - circ) = -40.0, a number the file states in
;; full and does not derive from the module. Without S-6, a `snap-open` hardwired to
;; 0.0 would satisfy S-4.
;;
;; SCENARIO ARITHMETIC, stated so every expectation below is derived and not fitted:
;; alice buys 3000 SPT at rpt 0.0 -> reward-debt 0.0
;; gen 1 seals at circ 3000, base 0.0; R1 rate 0.01 goes effective; gen 1 settles, corr 0.0
;; -> rpt 0.01, alice owed 3000 x 0.01 = 30.0
;; gen 2 seals at circ 3000, base 0.01
;; bob then buys 2000 NEW SPT -> circ 5000, sum-debt 2000 x 0.01 = 20.0
;; -> float delta (gcirc - circ) = 3000 - 5000 = -2000
;; R2 rate 0.02 declared against gen 2, effective later; cap = base + rate = 0.03
;; window : rpt 0.01 < 0.03 -> snap-open = (0.01 - 0.01) x -2000 = 0.0
;; award-liability = 0 + (0.01 x 5000 - 20) + 0 + 0 = 30.0 (= alice)
;; after : rpt 0.03 = cap -> snap-open = (0.03 - 0.01) x -2000 = -40.0
;; award-liability = 0 + (0.03 x 5000 - 20) + 0 - 40 = 90.0 (= alice)
;; bob bought AFTER the record instant, so his 40.0 of raw accrual is cancelled by his own
;; -40.0 correction and he is owed nothing — which is the whole point of the mechanism.
;; ===========================================================================
(load "setup.repl")

;; ---------------------------------------------------------------------------
;; S-1 — seed the float: alice 3000 SPT, bought before any record date exists.
;; ---------------------------------------------------------------------------
(begin-tx "S-1 seed float: alice 3000")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.init 0.5)
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.resume-sale)
(env-data { "alice": { "keys": ["alice-key"], "pred": "keys-all" }
       , "bob":   { "keys": ["bob-key"],   "pred": "keys-all" } })
(env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" "alice" 1500.0) (coin.TRANSFER "sender00" "bob" 1000.0)] }])
(coin.transfer-create "sender00" "alice" (read-keyset 'alice) 1500.0)
(coin.transfer-create "sender00" "bob"   (read-keyset 'bob)   1000.0)
(env-sigs [{ "key": "alice-key", "caps": [(coin.TRANSFER "alice" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1500.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "alice" (read-keyset 'alice) 3000.0)
(expect "seed: circulating 3000" 3000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(expect "seed: rpt starts at 0.0" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(commit-tx)

;; ---------------------------------------------------------------------------
;; S-2 — a first, ORDINARY round: seal gen 1, let R1 take effect, settle it.
;; This exists so the baseline liability in S-4 is a real non-zero number rather
;; than 0.0 — an assertion of "zero equals zero" would be a weak pin.
;; ---------------------------------------------------------------------------
(begin-tx "S-2a schedule the gen-1 record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (time "2026-06-02T00:00:00Z"))
(commit-tx)

(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-02T00:00:01Z") })
(begin-tx "S-2b seal gen 1 (permissionless)")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(expect "gen 1 sealed" 1 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-gen))
(expect "gen 1 latched the 3000 float" 3000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snapshot-circulating))
(commit-tx)

(begin-tx "S-2c fund and declare R1 at 0.01")
(env-keys ["admin-key"])
(let ((need (at 'shortfall (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed 0.01))))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

;; declare in its OWN tx: fund-awards installs a capability, which voids the unscoped
;; signature set for the rest of ITS transaction.
(begin-tx "S-2c2 declare R1 at 0.01")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
  "R1" 0.01 (time "2026-06-03T00:00:00Z"))
(commit-tx)

(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-03T00:00:01Z") })
(begin-tx "S-2d R1 is effective; settle gen 1")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(expect "rpt is now 0.01" 0.01
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "alice is owed 3000 x 0.01" 30.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "alice"))
(commit-tx)

;; ---------------------------------------------------------------------------
;; S-3 — seal gen 2, THEN move the float. Bob buys NEW tokens after the record
;; instant, so `circ` genuinely rises and `(- gcirc circ)` is non-zero. A transfer
;; would NOT do this: it debits and credits the same amount and leaves the delta 0,
;; which is precisely why the old suite never separated the branches.
;; ---------------------------------------------------------------------------
(begin-tx "S-3a schedule the gen-2 record date")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
  (time "2026-06-04T00:00:00Z"))
(commit-tx)

(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-04T00:00:01Z") })
(begin-tx "S-3b seal gen 2 at base = 0.01")
(env-keys [])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.advance-snapshot)
(expect "gen 2 sealed" 2 (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot-gen))
(expect "gen 2 base is the rpt at the record instant" 0.01
  (at 'base (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 2)))
(expect "gen 2 latched the 3000 float" 3000.0
  (at 'circ (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 2)))
(commit-tx)

(begin-tx "S-3c 🔴 bob BUYS after the record instant — the float actually MOVES")
(env-sigs [{ "key": "bob-key", "caps": [(coin.TRANSFER "bob" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.proceeds-account) 1000.0)] }])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT-launch.buy "bob" (read-keyset 'bob) 2000.0)
(expect "circulating rose to 5000 — this is issuance, not a transfer" 5000.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating))
(commit-tx)

(begin-tx "S-3d fund and declare R2 at 0.02 against gen 2")
(env-keys ["admin-key"])
(let ((need (at 'shortfall (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.funding-needed 0.02))))
  (env-sigs [{ "key": "admin-key", "caps": [(coin.TRANSFER "sender00" n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.FUNDING-ACCOUNT need)] }])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.receive-funding "sender00" need)
  (env-keys ["admin-key"])
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.fund-awards need))
(commit-tx)

(begin-tx "S-3d2 declare R2 at 0.02 against gen 2")
(env-keys ["admin-key"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
  "R2" 0.02 (time "2026-06-06T00:00:00Z"))
(commit-tx)

;; ===========================================================================
;; 🔴 S-4 — THE DECLARATION WINDOW. THIS IS THE BLOCK THAT KILLS M-A AND M-B.
;; Round declared, not yet effective, float already moved. Every precondition is
;; asserted first, because an assertion that the branch is 0.0 proves nothing
;; unless the branch was LIVE and the multiplier NON-ZERO.
;; ===========================================================================
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-05T00:00:00Z") })
(begin-tx "S-4 snap-open must not price an ineffective round")

;; --- preconditions: the low branch is live and the multiplier is not zero ---
(expect "the generation is still UNSETTLED (nothing has folded it)" false
  (at 'settled (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.chain-report)))
(expect "gen 2 carries the declared round: rate 0.02" 0.02
  (at 'rate (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 2)))
(expect "🔴 the float delta is NON-ZERO: 3000 sealed vs 5000 now" -2000.0
  (- (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snapshot-circulating)
     (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-circulating)))
(expect "🔴 rpt-at is STRICTLY BELOW cap — the min's low branch is the live one" true
  (< (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)
     (+ (at 'base (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 2))
        (at 'rate (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-snapshot 2)))))
(expect "and the round is genuinely not effective yet: rpt still 0.01" 0.01
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))

;; --- THE KILL ---------------------------------------------------------------
;; min(0.01, 0.03) - 0.01 = 0.0, so the whole term is 0.0 however far the float drifted.
;; M-A and M-B both take cap here and read (0.03 - 0.01) x -2000 = -40.0.
(expect "🔴 snap-open is EXACTLY 0.0 while the round is not yet effective"
  0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snap-open
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)))

;; the same fact seen through the function that actually matters
(expect "🔴 award-liability in the window is 30.0 — alice's R1 accrual, nothing else"
  30.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
;; --- S-4b — THE `(snap-open mrpt)` TERM IN `declared-liability`, PINNED (an internal review, a finding)
;; The assertions above evaluate snap-open at `get-rpt`, where the min's LOW branch makes the term
;; exactly 0.0 — which is the point of S-4, and is also why they cannot see this term at all.
;; `declared-liability` evaluates it at `max-rpt`, which INCLUDES the declared-but-not-yet-effective
;; round, so here the SAME term is live and non-zero. Deleting `(snap-open mrpt)` from
;; `declared-liability` left the entire suite green until this block existed.
;;
;; 🔴 WHY IT MATTERS: `pool-surplus` = poolbal - declared-liability, and `recover-pool-surplus`
;; moves REAL KDA out up to that number. Drop this term while the float has grown since the record
;; instant and the surplus OVER-reports by rate x (gcirc - circ) — money owed to holders reads as
;; money owed to nobody.
(expect "🔴 at max-rpt the SAME term is live: 0.02 x -2000" -40.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snap-open
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.max-rpt)))
(expect "🔴 declared-liability CARRIES it — 90.0, not the 130.0 it reads without the term" 90.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability))
;; and the ordering the docstring promises. 🔴 THIS ONE IS A CONSISTENCY CHECK, NOT THE PIN
;; (a finding, delta an internal review). It said "which the term is what makes true here" — MEASURED by
;; deleting `(snap-open mrpt)` from `declared-liability`: the assertion above (90.0 vs 130.0)
;; goes RED and this `>=` stays GREEN, because dropping the term makes declared-liability
;; LARGER, which satisfies `>=` all the more. Across the audit's 13 mutations it fired in zero.
;; Keep it — it pins the @doc's ordering — but do not read it as covering the term.
(expect "declared-liability >= award-liability, as its @doc states" true
  (>= (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declared-liability)
      (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))

(let ((naive (fold (+) 0.0
                (map (lambda (a:string)
                       (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                     ["alice" "bob"]))))
  (expect "🔴 O(1) == naive per-holder sum inside the declaration window" naive
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))
(commit-tx)

;; ===========================================================================
;; S-5 — WHY THE OTHER SIDE OF THE MIN IS UNREACHABLE, PINNED. Still inside the same
;; declaration window, on the SAME clock as S-4 — no rewind, so nothing here depends on
;; a time the chain could not actually be at.
;; `rpt-at > cap` with the generation still open cannot happen, and that is not a
;; property of the arithmetic — it is held by two enforces elsewhere in the module.
;; They are asserted here because S-4's claim "the window is the ONLY observable
;; branch" is only true while they are. Delete either one and these go red first.
;; Both are write-capable paths, so each gets its own rollback-tx.
;; ===========================================================================
(begin-tx "S-5a a SECOND round against the same generation is refused")
(env-keys ["admin-key"])
(expect-failure "one round per generation: rpt can never exceed base + rate while it is open"
  "SPT this record date already carries a declared round"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.declare-round
    "R2-DUP" 0.05 (time "2026-06-07T00:00:00Z")))
(rollback-tx)

(begin-tx "S-5b a new record date while a round is pending-effective is refused")
(env-keys ["admin-key"])
(expect-failure "at most one generation is open at a time, so no second rate can stack"
  "SPT cannot schedule a record date while a declared round is not yet effective"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.schedule-snapshot
    (time "2026-06-08T00:00:00Z")))
(rollback-tx)

;; ===========================================================================
;; S-6 — THE POSITIVE CONTROL. Same call, same state, one clock tick past
;; effective-at: the term must now be the FULL rate against the same delta. Without
;; this, S-4 would also pass against a `snap-open` hardwired to 0.0.
;; ===========================================================================
(env-chain-data { "chain-id": "0", "block-time": (time "2026-06-06T00:00:01Z") })
(begin-tx "S-6a the same term, now that R2 is effective")
(expect "rpt has jumped to base + rate" 0.03
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt))
(expect "🔴 snap-open is now rate x (gcirc - circ) = 0.02 x -2000" -40.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.snap-open
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.get-rpt)))
(expect "award-liability at the m-jump is 90.0 — still alice, and only alice" 90.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
(let ((naive (fold (+) 0.0
                (map (lambda (a:string)
                       (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of a))
                     ["alice" "bob"]))))
  (expect "O(1) == naive at the m-jump" naive
    (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability)))
(expect "bob bought after the record instant and is owed nothing" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.pending-awards-of "bob"))
(commit-tx)

(begin-tx "S-6b and the money is really there: alice claims all 90.0")
(let ((paid (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.claim-awards "alice")))
  (expect "alice is paid exactly what the read promised" 90.0 paid))
(expect "nothing is left owed on this chain" 0.0
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.SPT.award-liability))
(commit-tx)

(print "smartpacts-snapshot-open: PASSED")
